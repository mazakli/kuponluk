<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
  var expiredCoupons = (coupons||[]).filter(function(c){ return c.expiry_date && new Date(c.expiry_date) < new Date(); });
  var codeCoupons = (coupons || []).filter(function(c){ return c.code && c.code.trim() && (!c.expiry_date || new Date(c.expiry_date) >= new Date()); });
  var campaignCoupons = (coupons || []).filter(function(c){ return !c.code || !c.code.trim() && (!c.expiry_date || new Date(c.expiry_date) >= new Date()); });
  var otherCoupons = (coupons || []).filter(function(c){ return false; });
  var rating = parseFloat(avgRating) || 0;
  var fullStars = Math.floor(rating);
  var nowMs = Date.now();
%>

<!-- BREADCRUMB -->
<div class="max-w-6xl mx-auto px-4 pt-4 pb-0">
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 flex-wrap">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/magazalar" class="hover:text-orange-600 transition">Ma&#x11F;azalar</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium"><%= store.name %></span>
  </nav>
</div>

<div class="max-w-6xl mx-auto px-4 py-6">

  <!-- HAKKINDA (TOP) -->
  <section class="bg-white rounded-2xl shadow-sm border-2 border-gray-100 p-6 mb-6">
    <h2 class="text-lg font-bold text-gray-800 mb-3"><%= store.name %> Hakk&#x131;nda</h2>
    <% if (store.description) { %>
      <% var desc = store.description; var short = desc.length > 280; %>
      <p class="text-gray-600 text-sm leading-relaxed"><%= short ? desc.substring(0,280) : desc %></p>
      <% if (short) { %>
      <details class="mt-2 group">
        <summary class="cursor-pointer text-sm font-semibold inline-flex items-center gap-1 select-none list-none" style="color:#FF6B00;">Devam&#x131;n&#x131; oku <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
        <p class="text-gray-600 text-sm leading-relaxed mt-2"><%= desc.substring(280) %></p>
      </details>
      <% } %>
    <% } else { %>
    <p class="text-gray-600 text-sm leading-relaxed"><%= store.name %>, T&#xFC;rkiye'nin &#xF6;nde gelen e-ticaret ma&#x11F;azalar&#x131;ndan biridir. Kuponluk.com &#xFC;zerinden g&#xFC;ncel <%= store.name %> indirim kodlar&#x131;na ve kampanyalar&#x131;na ula&#x15F;abilirsiniz.</p>
    <% } %>
  </section>

  <!-- STORE HEADER -->
  <section class="bg-white rounded-2xl shadow-lg border-2 border-gray-100 overflow-hidden mb-6">
    <div class="h-14 w-full" style="background:linear-gradient(135deg,#FF6B00,#ff8c00);"></div>
    <div class="px-6 pb-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-end gap-4 -mt-10">
        <div class="flex-shrink-0">
          <div class="relative w-20 h-20 rounded-2xl overflow-hidden border-4 border-white shadow">
            <div class="absolute inset-0 flex items-center justify-center text-white text-3xl font-extrabold" style="background:#FF6B00;"><%= (store.name||'?').charAt(0).toUpperCase() %></div>
            <% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt="<%= store.name %> logo" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><% } %>
          </div>
        </div>
        <div class="flex-1 min-w-0 pb-1">
          <h1 class="text-2xl font-extrabold text-gray-900"><%= store.name %> &#x130;ndirim Kodu</h1>
          <div class="flex flex-wrap items-center gap-2 mt-2">
            <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full" style="background:#fff3e6;color:#FF6B00;">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              <%= codeCoupons.length %> &#x130;ndirim Kodu
            </span>
            <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <%= campaignCoupons.length %> Kampanya
            </span>
            <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600">
              <%= totalUses %> Kullan&#x131;m
            </span>
            <% if (store.category_name) { %>
            <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-600"><%= store.category_name %></span>
            <% } %>
            <span class="inline-flex items-center gap-0.5">
              <% for(var si=0;si<5;si++){%><svg class="w-3.5 h-3.5 <%= si<fullStars?'text-yellow-400':'text-gray-300' %>" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%>
              <span class="text-xs text-gray-500 ml-1"><%= rating.toFixed(1) %>/5</span>
            </span>
          </div>
        </div>
        <div class="flex gap-2 flex-shrink-0">
          <% if (store.website_url) { %>
          <a href="<%= store.website_url %>" target="_blank" rel="nofollow noopener" class="flex items-center gap-1.5 px-4 py-2 rounded-xl border-2 font-semibold text-gray-700 border-gray-200 hover:border-orange-400 hover:text-orange-600 transition text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            Siteye Git
          </a>
          <% } %>
          <% if (currentUser) { %>
          <form action="/magaza/<%= store.slug %>/favori" method="POST">
            <button type="submit" class="flex items-center gap-1.5 px-4 py-2 rounded-xl border-2 font-semibold transition text-sm <%= isFavorite?'text-white border-transparent':'text-gray-700 border-gray-200 hover:border-orange-400 hover:text-orange-600' %>" style="<%= isFavorite?'background:#FF6B00;border-color:#FF6B00;':'' %>">
              <svg class="w-4 h-4" fill="<%= isFavorite?'white':'none' %>" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              <%= isFavorite?'Favorilerde':'Favori' %>
            </button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <div class="flex flex-col lg:flex-row gap-6">
    <!-- MAIN -->
    <div class="flex-1 min-w-0 space-y-6">

      <!-- FILTER BAR -->
      <div class="bg-white rounded-2xl shadow-sm border-2 border-gray-100 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-1.5">
            <button onclick="filterBadge('all')" data-badge="all" class="badge-filter active-badge px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition">T&#xFC;m&#xFC; (<%= (coupons||[]).length %>)</button>
            <button onclick="filterBadge('code')" data-badge="code" class="badge-filter px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition">Kodlar (<%= codeCoupons.length %>)</button>
            <button onclick="filterBadge('campaign')" data-badge="campaign" class="badge-filter px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition">Kampanyalar (<%= campaignCoupons.length %>)</button>
            <button onclick="filterBadge('verified')" data-badge="verified" class="badge-filter px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Edit&#xF6;r Onayl&#x131;
            </button>
            <button onclick="filterBadge('expiring')" data-badge="expiring" class="badge-filter px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition flex items-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/></svg>
              T&#xFC;kenmek &#xDC;zere
            </button>
            <button onclick="filterBadge('isnew')" data-badge="isnew" class="badge-filter px-3 py-1.5 rounded-lg text-xs font-semibold border-2 transition flex items-center gap-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              En Yeni
            </button>
          </div>
          <select id="couponSort" onchange="sortAllCoupons(this.value)" class="text-xs border-2 border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-orange-300 bg-white">
            <option value="default">Varsay&#x131;lan</option>
            <option value="most_used">En &#xC7;ok Kullan&#x131;lan</option>
            <option value="newest">En Yeni</option>
          </select>
        </div>
      </div>

      <!-- CODES SECTION -->
      <% if (codeCoupons.length > 0) { %>
      <section id="section-codes">
        <h2 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg text-white text-xs font-bold flex-shrink-0" style="background:#FF6B00;"><%= codeCoupons.length %></span>
          <%= store.name %> &#x130;ndirim Kodlar&#x131;
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="codeList">
          <% codeCoupons.forEach(function(coupon){
            var isNew = coupon.created_at && (nowMs - new Date(coupon.created_at).getTime()) < 7*24*60*60*1000;
            var isExpiring = coupon.expiry_date && new Date(coupon.expiry_date) > new Date() && (new Date(coupon.expiry_date).getTime() - nowMs) < 7*24*60*60*1000;
            var isVerified = coupon.verified || coupon.is_verified || coupon.editor_approved;
            var dv = coupon.discount_value;
            var dt = coupon.discount_type;
            var displayTitle = coupon.title || (dv && dt==='percentage' ? '%'+dv+' '+store.name+' İndirim Kodu' : dv ? store.name+' '+dv+' TL İndirim Kodu' : store.name+' İndirim Kodu');
          %>
          <article class="coupon-card bg-white rounded-2xl border-2 border-gray-100 shadow-sm hover:shadow-md hover:border-orange-200 transition overflow-hidden"
            data-type="code"
            data-use-count="<%= coupon.use_count||0 %>"
            data-created-at="<%= coupon.created_at||'' %>"
            data-verified="<%= isVerified?'1':'0' %>"
            data-expiring="<%= isExpiring?'1':'0' %>"
            data-new="<%= isNew?'1':'0' %>">
            <div class="h-1 w-full" style="background:linear-gradient(90deg,#FF6B00,#ff8c00);"></div>
            <div class="p-4">
              <div class="flex flex-wrap gap-1 mb-2">
                <span class="text-xs font-bold px-2 py-0.5 rounded-full" style="background:#fff3e6;color:#FF6B00;">KOD</span>
                <% if(isVerified){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-green-50 text-green-700"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Edit&#xF6;r Onayl&#x131;</span><%}%>
                <% if(isExpiring){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-red-50 text-red-600"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/></svg> T&#xFC;kenmek &#xDC;zere</span><%}%>
                <% if(isNew){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg> En Yeni</span><%}%>
              </div>
              <h3 class="font-bold text-gray-800 text-sm leading-snug mb-1"><%= displayTitle %></h3>
              <% if(coupon.description){%><p class="text-xs text-gray-500 leading-relaxed mb-2 line-clamp-2"><%= coupon.description %></p><%}%>
              <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                <% if(coupon.use_count){%><span><%= coupon.use_count %> kez kullan&#x131;ld&#x131;</span><%}%>
                <% if(coupon.expiry_date){%><span>Son: <%= new Date(coupon.expiry_date).toLocaleDateString('tr-TR') %></span><%}%>
              </div>
              <div class="flex items-center gap-2">
                <div class="flex-1 bg-gray-50 border-2 border-dashed border-gray-300 rounded-xl px-3 py-2 text-center overflow-hidden">
                  <span class="text-sm font-extrabold tracking-widest text-gray-700"><%= coupon.code %></span>
                </div>
                <button onclick="openCouponModalFromBtn(this)"
                  data-coupon-id="<%= coupon.id %>"
                  data-coupon-code="<%= coupon.code||'' %>"
                  data-coupon-title="<%= displayTitle %>"
                  data-store-url="<%= store.website_url||'' %>"
                  data-store-name="<%= store.name %>"
                  data-store-id="<%= store.id %>"
                  class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-white font-bold text-xs transition hover:opacity-90 whitespace-nowrap flex-shrink-0"
                  style="background:#FF6B00;">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  Kodu Al
                </button>
              </div>
            </div>
          </article>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- CAMPAIGNS SECTION -->
      <% if (campaignCoupons.length > 0) { %>
      <section id="section-campaigns">
        <h2 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg text-white text-xs font-bold flex-shrink-0" style="background:#2563eb;"><%= campaignCoupons.length %></span>
          <%= store.name %> Kampanyalar&#x131;
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="campaignList">
          <% campaignCoupons.forEach(function(coupon){
            var isNew = coupon.created_at && (nowMs - new Date(coupon.created_at).getTime()) < 7*24*60*60*1000;
            var isExpiring = coupon.expiry_date && new Date(coupon.expiry_date) > new Date() && (new Date(coupon.expiry_date).getTime() - nowMs) < 7*24*60*60*1000;
            var isVerified = coupon.verified || coupon.is_verified || coupon.editor_approved;
            var dv = coupon.discount_value;
            var displayTitle = coupon.title || (dv ? store.name+' '+dv+(coupon.discount_type==='percentage'?'%':' TL')+' Kampanyası' : store.name+' Kampanyası');
          %>
          <article class="coupon-card bg-white rounded-2xl border-2 border-gray-100 shadow-sm hover:shadow-md hover:border-blue-200 transition overflow-hidden"
            data-type="campaign"
            data-use-count="<%= coupon.use_count||0 %>"
            data-created-at="<%= coupon.created_at||'' %>"
            data-verified="<%= isVerified?'1':'0' %>"
            data-expiring="<%= isExpiring?'1':'0' %>"
            data-new="<%= isNew?'1':'0' %>">
            <div class="h-1 w-full" style="background:linear-gradient(90deg,#2563eb,#60a5fa);"></div>
            <div class="p-4">
              <div class="flex flex-wrap gap-1 mb-2">
                <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600">KAMPANYA</span>
                <% if(isVerified){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-green-50 text-green-700"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Edit&#xF6;r Onayl&#x131;</span><%}%>
                <% if(isExpiring){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-red-50 text-red-600"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/></svg> T&#xFC;kenmek &#xDC;zere</span><%}%>
                <% if(isNew){%><span class="inline-flex items-center gap-0.5 text-xs font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg> En Yeni</span><%}%>
              </div>
              <h3 class="font-bold text-gray-800 text-sm leading-snug mb-1"><%= displayTitle %></h3>
              <% if(coupon.description){%><p class="text-xs text-gray-500 leading-relaxed mb-2 line-clamp-2"><%= coupon.description %></p><%}%>
              <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                <% if(coupon.use_count){%><span><%= coupon.use_count %> kez kullan&#x131;ld&#x131;</span><%}%>
                <% if(coupon.expiry_date){%><span>Son: <%= new Date(coupon.expiry_date).toLocaleDateString('tr-TR') %></span><%}%>
              </div>
              <a href="<%= store.website_url||'#' %>" target="_blank" rel="nofollow noopener"
                class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl text-white font-bold text-xs transition hover:opacity-90"
                style="background:#16a34a;">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                Kampanyaya Git
              </a>
            </div>
          </article>
          <% }); %>
        </div>
