            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
            Hay&#x131;r
          </button>
        </div>
        <p id="feedbackMsg" class="text-xs text-center mt-2 hidden"></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium mb-2">Arkada&#x15F;lar&#x131;nla payla&#x15F;</p>
        <div class="flex gap-2">
          <a id="shareWhatsapp" href="#" target="_blank" rel="noopener" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-white text-xs font-semibold" style="background:#25D366;"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>WhatsApp</a>
          <a id="shareTwitter" href="#" target="_blank" rel="noopener" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-white text-xs font-semibold" style="background:#1DA1F2;"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>Twitter</a>
          <button onclick="copyShareLink()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border-2 border-gray-200 text-gray-600 text-xs font-semibold hover:bg-gray-50 transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>Link</button>
        </div>
      </div>
      <div class="bg-blue-50 rounded-xl p-4 border-2 border-blue-100">
        <p class="text-xs font-bold text-blue-700 mb-2">Nas&#x131;l Kullan&#x131;l&#x131;r?</p>
        <ol class="text-xs text-blue-600 space-y-1 list-none">
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">1</span> Kodu kopyalay&#x131;n.</li>
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">2</span> Ma&#x11F;azada al&#x131;&#x15F;veri&#x15F;inizi sepete ekleyin.</li>
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">3</span> &#xD6;deme sayfas&#x131;nda &ldquo;&#x130;ndirim Kodu&rdquo; alan&#x131;na yap&#x131;&#x15F;t&#x131;r&#x131;n.</li>
        </ol>
      </div>
      <a id="modalStoreLink" href="#" target="_blank" rel="nofollow noopener" class="flex items-center justify-center gap-2 w-full py-3 rounded-xl text-white font-bold text-base transition hover:opacity-90" style="background:#16a34a;">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        Al&#x131;&#x15F;veri&#x15F;e Ba&#x15F;la
      </a>
      <div class="border-t border-gray-100 pt-4">
        <p class="text-xs text-gray-500 mb-2">Yeni kuponlardan haberdar olmak ister misiniz?</p>
        <form id="modalSubForm" class="flex gap-2">
          <input type="hidden" name="store_id" id="modalStoreId" value=""/>
          <input type="email" name="email" placeholder="E-posta adresiniz" required value="<%= currentUser?currentUser.email:'' %>" class="flex-1 px-3 py-2 rounded-xl border-2 border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-orange-300"/>
          <button type="submit" class="text-white text-xs font-semibold px-4 py-2 rounded-xl hover:opacity-90 whitespace-nowrap transition" style="background:#FF6B00;">Abone Ol</button>
        </form>
        <p id="modalSubMsg" class="text-xs mt-1 hidden"></p>
      </div>
    </div>
  </div>
</div>

<style>
.badge-filter{color:#6b7280;border-color:#e5e7eb;background:#f9fafb;}
.active-badge{background:#FF6B00;color:#fff;border-color:#FF6B00;}
.coupon-card.hidden-card{display:none;}
</style>

<script>
var currentCouponCode='',currentStoreUrl='',currentCouponId='';
function openCouponModal(id,code,title,storeUrl,storeName,storeId){
  currentCouponCode=code;currentStoreUrl=storeUrl;currentCouponId=id;
  document.getElementById('modalTitle').textContent=title||(storeName+' İndirim Kodu');
  document.getElementById('modalCode').textContent=code;
  document.getElementById('modalStoreLink').href=storeUrl||'#';
  document.getElementById('modalStoreId').value=storeId||'';
  var pu=encodeURIComponent(window.location.href);
  var st=encodeURIComponent('"'+code+'" kupon kodunu kullan, '+storeName+"'de indirim kazan! ");
  document.getElementById('shareWhatsapp').href='https://wa.me/?text='+st+pu;
  document.getElementById('shareTwitter').href='https://twitter.com/intent/tweet?text='+st+'&url='+pu;
  document.getElementById('copyMsg').classList.add('hidden');
  document.getElementById('feedbackMsg').classList.add('hidden');
  document.getElementById('feedbackYes').style.background='';
  document.getElementById('feedbackNo').style.background='';
  var m=document.getElementById('couponModal');
  m.classList.remove('hidden');m.classList.add('flex');
}
function openCouponModalFromBtn(btn){var d=btn.dataset;openCouponModal(d.couponId,d.couponCode,d.couponTitle,d.storeUrl,d.storeName,d.storeId);}
function closeCouponModal(){
  var m=document.getElementById('couponModal');
  m.classList.add('hidden');m.classList.remove('flex');
}
document.getElementById('couponModal').addEventListener('click',function(e){if(e.target===this)closeCouponModal();});
function copyModalCode(){
  if(!currentCouponCode)return;
  navigator.clipboard.writeText(currentCouponCode).then(function(){
    var msg=document.getElementById('copyMsg');
    msg.classList.remove('hidden');
    setTimeout(function(){msg.classList.add('hidden');},2500);
  });
}
function copyShareLink(){navigator.clipboard.writeText(window.location.href).then(function(){alert('Sayfa linki kopyalandı!');});}
function submitFeedback(pos){
  var yb=document.getElementById('feedbackYes'),nb=document.getElementById('feedbackNo'),msg=document.getElementById('feedbackMsg');
  if(pos){yb.style.background='#dcfce7';nb.style.background='';msg.textContent='Teşekk\xFCrler!';msg.style.color='#16a34a';}
  else{nb.style.background='#fee2e2';yb.style.background='';msg.textContent='\xDCzg\xFCn\xFCz, en kısa s\xFCrede g\xFCncelleyeceğiz.';msg.style.color='#dc2626';}
  msg.classList.remove('hidden');
  if(currentCouponId)fetch('/kupon/'+currentCouponId+'/geri-bildirim',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'positive='+(pos?'1':'0')}).catch(function(){});
}
var activeBadge='all';
function filterBadge(type){
  activeBadge=type;
  document.querySelectorAll('.badge-filter').forEach(function(btn){
    var a=btn.dataset.badge===type;
    btn.style.background=a?'#FF6B00':'#f9fafb';
    btn.style.color=a?'white':'#6b7280';
    btn.style.borderColor=a?'#FF6B00':'#e5e7eb';
  });
  document.querySelectorAll('.coupon-card').forEach(function(card){
    var show=true;
    if(type==='code')show=card.dataset.type==='code';
    else if(type==='campaign')show=card.dataset.type==='campaign';
    else if(type==='verified')show=card.dataset.verified==='1';
    else if(type==='expiring')show=card.dataset.expiring==='1';
    else if(type==='isnew')show=card.dataset.new==='1';
    card.classList.toggle('hidden-card',!show);
  });
}
function sortAllCoupons(val){
  ['codeList','campaignList'].forEach(function(lid){
    var list=document.getElementById(lid);if(!list)return;
    var items=Array.from(list.querySelectorAll('.coupon-card'));
    items.sort(function(a,b){
      if(val==='most_used')return parseInt(b.dataset.useCount||0)-parseInt(a.dataset.useCount||0);
      if(val==='newest')return (b.dataset.createdAt||'').localeCompare(a.dataset.createdAt||'');
      return 0;
    });
    items.forEach(function(i){list.appendChild(i);});
  });
}
var ssf=document.getElementById('storeSubForm');
if(ssf)ssf.addEventListener('submit',function(e){e.preventDefault();fetch('/marka-abone-ol',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(ssf)).toString()}).then(function(r){return r.json();}).then(function(d){var m=document.getElementById('storeSubMsg');m.textContent=d.message;m.style.color=d.success?'#16a34a':'#dc2626';m.classList.remove('hidden');if(d.success)ssf.querySelector('input[type=email]').value='';});});
var msf=document.getElementById('modalSubForm');
if(msf)msf.addEventListener('submit',function(e){e.preventDefault();fetch('/marka-abone-ol',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(msf)).toString()}).then(function(r){return r.json();}).then(function(d){var m=document.getElementById('modalSubMsg');m.textContent=d.message;m.style.color=d.success?'#16a34a':'#dc2626';m.classList.remove('hidden');if(d.success)msf.querySelector('input[type=email]').value='';});});
</script>

<%- include('partials/footer') %>
</body>
</html>