<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Breadcrumb -->
<div class="max-w-6xl mx-auto px-4 pt-4">
  <div class="inline-flex items-center gap-1.5 bg-white border border-gray-200 rounded-xl px-4 py-2 text-sm">
    <a href="/" class="text-gray-500 hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-semibold">Popüler Kuponlar</span>
  </div>
</div>

<!-- Page Header -->
<div class="mt-4 py-6 px-4" style="background:linear-gradient(135deg,#0d1b3e 0%,#1a3466 100%);">
  <div class="max-w-6xl mx-auto flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(255,255,255,0.12);">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
    </div>
    <div>
      <h1 class="text-2xl font-extrabold text-white">Popüler Kuponlar</h1>
      <p class="text-sm mt-0.5" style="color:rgba(255,255,255,0.6);">Kullanıcılarımızın en çok tercih ettiği ve en yüksek puanlı kuponlar.</p>
    </div>
  </div>
</div>

<div class="max-w-6xl mx-auto px-4 py-8">
  <% if (coupons && coupons.length > 0) { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
    <% coupons.forEach(function(coupon) { %>
    <%- include('partials/coupon-card', { coupon: coupon }) %>
    <% }); %>
  </div>
  <% } else { %>
  <div class="bg-white rounded-2xl border border-gray-100 shadow p-16 text-center">
    <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
    <h3 class="text-xl font-semibold text-gray-700 mb-2">Henüz Popüler Kupon Yok</h3>
    <p class="text-gray-500">Yakında en popüler kuponlar burada görüntülenecek.</p>
    <a href="/" class="inline-block mt-4 px-6 py-2 rounded-xl text-white font-semibold transition hover:opacity-90" style="background:linear-gradient(135deg,#e55a04,#f97316);">Ana Sayfaya Dön</a>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
</body>
</html>
