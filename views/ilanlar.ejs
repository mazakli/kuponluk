<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-6xl mx-auto px-4 py-8">

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium">İlanlar</span>
  </nav>

  <div class="mb-6 flex items-center justify-between flex-wrap gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900">İlanlar</h1>
      <p class="text-gray-500 mt-1">Üyelerimizin paylaştığı kupon ve indirim ilanları</p>
    </div>
    <a href="/ilanlar/olustur" class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm hover:opacity-90 transition" style="background:#FF6B00;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      İlan Ver
    </a>
  </div>

  <div class="flex flex-col lg:flex-row gap-6">

    <!-- Left Sidebar Filters -->
    <aside class="lg:w-64 flex-shrink-0">
      <div class="bg-white rounded-2xl shadow-sm border-2 border-gray-100 p-5 sticky top-12">
        <h3 class="font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
          Filtrele
        </h3>

        <form action="/ilanlar" method="GET">
          <!-- Price Type -->
          <div class="mb-5">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Fiyat Türü</p>
            <div class="space-y-1.5">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tip" value="" <%= !filterType ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700">Tümü</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tip" value="ucretsiz" <%= filterType==='ucretsiz' ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700">Ücretsiz</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tip" value="ucretli" <%= filterType==='ucretli' ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700">Üretli</span>
              </label>
            </div>
          </div>

          <!-- Price Range -->
          <div class="mb-5">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Kupon Miktarı (TL)</p>
            <div class="space-y-2">
              <div>
                <label class="text-xs text-gray-400 mb-1 block">En Az</label>
                <input type="number" name="minFiyat" value="<%= filterMinFiyat || '' %>" placeholder="0" min="0"
                  class="w-full border-2 border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-orange-300 transition">
              </div>
              <div>
                <label class="text-xs text-gray-400 mb-1 block">En Fazla</label>
                <input type="number" name="maxFiyat" value="<%= filterMaxFiyat || '' %>" placeholder="∞" min="0"
                  class="w-full border-2 border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-orange-300 transition">
              </div>
            </div>
          </div>

          <% if (categories && categories.length > 0) { %>
          <div class="mb-5">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Kategori</p>
            <div class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="kategori" value="" <%= !filterCategory ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700">Tümü</span>
              </label>
              <% categories.forEach(function(cat){ %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="kategori" value="<%= cat %>" <%= filterCategory===cat ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700"><%= cat %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% } %>

          <% if (storeNames && storeNames.length > 0) { %>
          <div class="mb-5">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Mağaza</p>
            <div class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="magaza" value="" <%= !filterStore ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700">Tümü</span>
              </label>
              <% storeNames.forEach(function(sn){ %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="magaza" value="<%= sn %>" <%= filterStore===sn ? 'checked' : '' %> class="accent-orange-500">
                <span class="text-sm text-gray-700"><%= sn %></span>
              </label>
              <% }); %>
            </div>
          </div>
          <% } %>

          <button type="submit" class="w-full text-white font-bold py-2.5 rounded-xl transition hover:opacity-90 text-sm" style="background:#FF6B00;">Filtrele</button>
          <a href="/ilanlar" class="block w-full text-center mt-2 text-sm text-gray-500 hover:text-orange-600 transition">Temizle</a>
        </form>
      </div>
    </aside>

    <!-- Listings Grid -->
    <div class="flex-1 min-w-0">
      <% if (listings && listings.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        <% listings.forEach(function(listing){ %>
        <article class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm hover:shadow-md hover:border-orange-200 transition overflow-hidden flex flex-col">
          <div class="h-1 w-full" style="background:linear-gradient(90deg,#FF6B00,#ff8c00);"></div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex-1 min-w-0">
                <% if (listing.category) { %>
                <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-orange-50 text-orange-600 mb-1 inline-block"><%= listing.category %></span>
                <% } %>
                <h3 class="font-bold text-gray-800 text-sm leading-snug mt-1"><%= listing.title %></h3>
                <p class="text-xs text-gray-500 mt-0.5"><%= listing.store_name %></p>
              </div>
              <div class="flex-shrink-0">
                <% if (listing.is_free) { %>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-green-50 text-green-700">Ücretsiz</span>
                <% } else if (listing.price) { %>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700"><%= listing.price %> TL</span>
                <% } %>
              </div>
            </div>

            <% if (listing.description) { %>
            <p class="text-xs text-gray-500 leading-relaxed mb-3 flex-1"><%= listing.description.length > 100 ? listing.description.substring(0,100)+'...' : listing.description %></p>
            <% } %>

            <% if (listing.coupon_code) { %>
            <div class="bg-orange-50 border-2 border-dashed border-orange-200 rounded-xl px-3 py-2 text-center mb-3">
              <span class="text-sm font-extrabold tracking-widest" style="color:#FF6B00;"><%= listing.coupon_code %></span>
            </div>
            <% } %>

            <div class="flex items-center justify-between text-xs text-gray-400 mt-auto pt-2 border-t border-gray-50">
              <span class="font-medium text-gray-500"><%= listing.username || 'Üye' %></span>
              <% if (listing.expires_at) { %>
              <span>Son: <%= new Date(listing.expires_at).toLocaleDateString('tr-TR') %></span>
              <% } %>
            </div>
          </div>
        </article>
        <% }); %>
      </div>
      <% } else { %>
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-16 text-center">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Henüz İlan Yok</h3>
        <p class="text-gray-500 mb-4">Onaylanmış ilan bulunmuyor. İlk ilanı siz oluşturun!</p>
        <a href="/ilanlar/olustur" class="inline-block px-6 py-2.5 rounded-xl text-white font-bold transition hover:opacity-90" style="background:#FF6B00;">İlan Oluştur</a>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
