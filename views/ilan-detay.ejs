<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-4xl mx-auto px-4 py-8">

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/ilanlar" class="hover:text-orange-600 transition">İlanlar</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium truncate max-w-xs"><%= listing.title %></span>
  </nav>

  <div class="flex flex-col lg:flex-row gap-6">

    <!-- Main Content -->
    <div class="flex-1 min-w-0 space-y-5">

      <!-- Title Card -->
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm overflow-hidden">
        <div class="h-1.5 w-full" style="background:linear-gradient(90deg,#FF6B00,#ff8c00);"></div>
        <div class="p-6">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <% if (listing.category) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-orange-50 text-orange-600"><%= listing.category %></span>
            <% } %>
            <% if (listing.is_free) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-green-50 text-green-700">Ücretsiz</span>
            <% } else if (listing.price) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700"><%= listing.price %> TL Değerinde</span>
            <% } %>
            <% if (listing.coupon_code) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="background:#fff3e6;color:#FF6B00;">İNDİRİM KODU</span>
            <% } %>
            <% if (listing.status === 'pending') { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-yellow-50 text-yellow-700">Onay Bekliyor</span>
            <% } %>
          </div>
          <h1 class="text-2xl font-extrabold text-gray-900 mb-2"><%= listing.title %></h1>
          <p class="text-sm text-gray-500 flex items-center gap-1.5">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <%= listing.store_name %>
            <% if (listing.username) { %>
            &bull; <span class="text-gray-400">Paylaşan: <strong class="text-gray-600"><%= listing.username %></strong></span>
            <% } %>
          </p>
        </div>
      </div>

      <!-- Coupon Code - Locked -->
      <% if (listing.coupon_code) { %>
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6">
        <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
          İndirim Kodu
        </h2>
        <div class="rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 p-6 text-center">
          <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <p class="font-bold text-gray-700 mb-1">Kupon Kodu Kilitli</p>
          <p class="text-sm text-gray-500">Satıcı ile iletişime geçip satın alma işlemini tamamladıktan sonra kupon kodu size iletilecektir.</p>
        </div>
      </div>
      <% } %>

      <!-- Description -->
      <% if (listing.description) { %>
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6">
        <h2 class="text-base font-bold text-gray-800 mb-3">Açıklama</h2>
        <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line"><%= listing.description %></p>
      </div>
      <% } %>

    </div>

    <!-- Sidebar -->
    <aside class="lg:w-72 flex-shrink-0 space-y-4">

      <!-- Details Card -->
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-5">
        <h3 class="font-bold text-gray-800 text-sm mb-4">İlan Detayları</h3>
        <dl class="space-y-3">
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Mağaza</dt>
            <dd class="font-semibold text-gray-800"><%= listing.store_name %></dd>
          </div>
          <% if (listing.category) { %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Kategori</dt>
            <dd class="font-semibold text-gray-800"><%= listing.category %></dd>
          </div>
          <% } %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Paylaşan</dt>
            <dd class="font-semibold text-gray-800"><%= listing.username || 'Anonim Üye' %></dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Tarih</dt>
            <dd class="font-semibold text-gray-800"><%= new Date(listing.created_at).toLocaleDateString('tr-TR') %></dd>
          </div>
          <% if (listing.expires_at) { %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Son Kullanım</dt>
            <dd class="font-semibold <%= new Date(listing.expires_at) < new Date() ? 'text-red-500' : 'text-gray-800' %>"><%= new Date(listing.expires_at).toLocaleDateString('tr-TR') %></dd>
          </div>
          <% } %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Değer</dt>
            <dd class="font-semibold text-gray-800">
              <% if (listing.is_free) { %><span class="text-green-600">Ücretsiz</span>
              <% } else if (listing.price) { %><%= listing.price %> TL
              <% } else { %>Belirtilmemiş<% } %>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Contact / Mesaj CTA -->
      <div class="bg-white rounded-2xl border-2 border-orange-100 shadow-sm p-5">
        <% if (currentUser && listing.user_id && parseInt(listing.user_id) !== parseInt(currentUser.id)) { %>
          <!-- Buyer: send message form -->
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-6 h-6 flex-shrink-0" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <h4 class="font-bold text-gray-800 text-sm">Satıcıya Mesaj Gönder</h4>
          </div>
          <form method="POST" action="/mesajlar/yeni">
            <input type="hidden" name="to_user_id" value="<%= listing.user_id %>">
            <input type="hidden" name="listing_id" value="<%= listing.id %>">
            <input type="hidden" name="from_ilan" value="<%= listing.id %>">
            <textarea name="body" rows="3" required maxlength="2000"
              placeholder="Kupon kodu hakkında satıcıya soru sorun..."
              class="w-full border-2 border-gray-200 rounded-xl px-3 py-2.5 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-300 transition mb-2"></textarea>
            <button type="submit" class="w-full py-2.5 rounded-xl text-white font-bold text-sm hover:opacity-90 transition flex items-center justify-center gap-2" style="background:#FF6B00;">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Mesaj Gönder
            </button>
          </form>
        <% } else if (currentUser && listing.user_id && parseInt(listing.user_id) === parseInt(currentUser.id)) { %>
          <!-- Seller: own listing -->
          <div class="text-center">
            <svg class="w-10 h-10 mx-auto mb-2" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            <h4 class="font-bold text-gray-800 text-sm mb-1">Bu ilanınız</h4>
            <p class="text-xs text-gray-500 mb-3">Alıcılardan gelen mesajları görüntüleyin.</p>
            <a href="/mesajlar" class="inline-block w-full py-2.5 rounded-xl border-2 font-bold text-sm transition hover:bg-orange-50" style="border-color:#FF6B00;color:#FF6B00;">Mesajlarımı Gör</a>
          </div>
        <% } else if (currentUser && !listing.user_id) { %>
          <!-- Logged in but anonymous listing -->
          <div class="text-center">
            <svg class="w-10 h-10 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <h4 class="font-bold text-gray-700 text-sm mb-1">Anonim İlan</h4>
            <p class="text-xs text-gray-400 mb-3">Bu ilan satıcı bilgisi olmadan paylaşılmış.</p>
            <a href="/ilanlar" class="inline-block w-full py-2.5 rounded-xl border-2 font-bold text-sm transition hover:bg-orange-50" style="border-color:#FF6B00;color:#FF6B00;">İlanlara Dön</a>
          </div>
        <% } else { %>
          <!-- Not logged in -->
          <div class="text-center">
            <svg class="w-10 h-10 mx-auto mb-3" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <h4 class="font-bold text-gray-800 text-sm mb-1">Satıcıya Ulaşın</h4>
            <p class="text-xs text-gray-500 mb-3">Mesaj göndermek için giriş yapmanız gerekiyor.</p>
            <a href="/giris?redirect=/ilanlar/<%= listing.id %>" class="inline-block w-full py-2.5 rounded-xl text-white font-bold text-sm transition hover:opacity-90" style="background:#FF6B00;">Giriş Yap</a>
          </div>
        <% } %>
      </div>

      <!-- Post CTA -->
      <a href="/ilanlar/olustur" class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl text-white font-bold text-sm hover:opacity-90 transition" style="background:#FF6B00;">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        İlan Oluştur
      </a>

    </aside>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
