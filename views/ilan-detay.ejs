<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-4xl mx-auto px-4 py-8">

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/ilanlar" class="hover:text-orange-600 transition">&#x130;lanlar</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium truncate max-w-xs"><%= listing.title %></span>
  </nav>

  <div class="flex flex-col lg:flex-row gap-6">

    <!-- Main Content -->
    <div class="flex-1 min-w-0 space-y-5">

      <!-- Title Card -->
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm overflow-hidden">
        <div class="h-1.5 w-full" style="background:linear-gradient(90deg,#FF6B00,#ff8c00);"></div>
        <div class="p-6">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <% if (listing.category) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-orange-50 text-orange-600"><%= listing.category %></span>
            <% } %>
            <% if (listing.is_free) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-green-50 text-green-700">&#xDC;cretsiz</span>
            <% } else if (listing.price) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700"><%= listing.price %> TL De&#x11F;erinde</span>
            <% } %>
            <% if (listing.coupon_code) { %>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="background:#fff3e6;color:#FF6B00;">&#x130;nd&#x130;r&#x130;m KODU</span>
            <% } %>
          </div>
          <h1 class="text-2xl font-extrabold text-gray-900 mb-2"><%= listing.title %></h1>
          <p class="text-sm text-gray-500 flex items-center gap-1.5">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <%= listing.store_name %>
          </p>
        </div>
      </div>

      <!-- Coupon Code Band -->
      <% if (listing.coupon_code) { %>
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6">
        <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
          &#x130;ndirim Kodu
        </h2>
        <div id="codeBand" class="relative overflow-hidden rounded-2xl border-2 border-dashed border-orange-300 cursor-pointer select-none"
          style="background:linear-gradient(90deg,#fff8f0,#ffede0);" onclick="revealCode(this,'<%= listing.coupon_code %>')">          <div class="px-6 py-5 text-center" style="visibility:hidden;">
            <span class="text-2xl font-extrabold tracking-widest text-gray-800"><%= listing.coupon_code %></span>
          </div>
          <div id="bandOverlay" class="absolute inset-0 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <span class="font-bold text-base" style="color:#FF6B00;">T&#x131;klay&#x131;n, kodu g&#xF6;r&#xFC;n ve kopyalay&#x131;n</span>
          </div>
        </div>
        <p id="copyConfirm" class="text-center text-sm text-green-600 font-semibold mt-3 hidden">&#x2713; Kod kopyaland&#x131;!</p>
      </div>
      <% } %>

      <!-- Description -->
      <% if (listing.description) { %>
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6">
        <h2 class="text-base font-bold text-gray-800 mb-3">A&#xE7;&#x131;klama</h2>
        <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line"><%= listing.description %></p>
      </div>
      <% } %>

    </div>

    <!-- Sidebar -->
    <aside class="lg:w-72 flex-shrink-0 space-y-4">

      <!-- Details Card -->
      <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-5">
        <h3 class="font-bold text-gray-800 text-sm mb-4">&#x130;lan Detaylar&#x131;</h3>
        <dl class="space-y-3">
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Ma&#x11F;aza</dt>
            <dd class="font-semibold text-gray-800"><%= listing.store_name %></dd>
          </div>
          <% if (listing.category) { %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Kategori</dt>
            <dd class="font-semibold text-gray-800"><%= listing.category %></dd>
          </div>
          <% } %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Payla&#x15F;an</dt>
            <dd class="font-semibold text-gray-800"><%= listing.username || 'Anonim &#xDC;ye' %></dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Tarih</dt>
            <dd class="font-semibold text-gray-800"><%= new Date(listing.created_at).toLocaleDateString('tr-TR') %></dd>
          </div>
          <% if (listing.expires_at) { %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">Son Kullan&#x131;m</dt>
            <dd class="font-semibold <%= new Date(listing.expires_at) < new Date() ? 'text-red-500' : 'text-gray-800' %>"><%= new Date(listing.expires_at).toLocaleDateString('tr-TR') %></dd>
          </div>
          <% } %>
          <div class="flex justify-between text-sm">
            <dt class="text-gray-500">De&#x11F;er</dt>
            <dd class="font-semibold text-gray-800">
              <% if (listing.is_free) { %>
              <span class="text-green-600">&#xDC;cretsiz</span>
              <% } else if (listing.price) { %>
              <%= listing.price %> TL
              <% } else { %>
              Belirtilmemi&#x15F;
              <% } %>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Back Button -->
      <a href="/ilanlar" class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl border-2 border-gray-200 text-gray-600 font-semibold text-sm hover:border-orange-300 hover:text-orange-600 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        T&#xFC;m &#x130;lanlara D&#xF6;n
      </a>

      <!-- Post Listing CTA -->
      <div class="bg-white rounded-2xl border-2 border-orange-100 shadow-sm p-5 text-center">
        <svg class="w-10 h-10 mx-auto mb-3" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <h4 class="font-bold text-gray-800 text-sm mb-1">Siz de ilan verin!</h4>
        <p class="text-xs text-gray-500 mb-3">Kupon veya indirim kodunuzu payla&#x15F;&#x131;n.</p>
        <a href="/ilanlar/olustur" class="inline-block w-full py-2.5 rounded-xl text-white font-bold text-sm hover:opacity-90 transition" style="background:#FF6B00;">&#x130;lan Olu&#x15F;tur</a>
      </div>

    </aside>
  </div>
</div>

<script>
function revealCode(el, code) {
  var overlay = document.getElementById('bandOverlay');
  var inner = el.querySelector('.px-6');
  overlay.style.display = 'none';
  inner.style.visibility = 'visible';
  el.style.cursor = 'default';
  el.onclick = null;
  if (navigator.clipboard && code) {
    navigator.clipboard.writeText(code).then(function() {
      var msg = document.getElementById('copyConfirm');
      if (msg) { msg.classList.remove('hidden'); setTimeout(function(){ msg.classList.add('hidden'); }, 3000); }
    }).catch(function(){});
  }
}
</script>

<%- include('partials/footer') %>
</body>
</html>
