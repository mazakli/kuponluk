<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Slider + Brand List -->
<% if (sliders && sliders.length > 0) { %>
<section class="py-6 px-4" style="background:#f3f4f6">
  <div class="max-w-6xl mx-auto">
    <div class="flex gap-4 items-stretch">

      <!-- Slider (left, flexible) -->
      <div class="flex-1 min-w-0 relative overflow-hidden rounded-2xl shadow-lg bg-gray-200" id="mainSlider" style="aspect-ratio:16/9; max-height:420px;">
        <div class="flex h-full" id="sliderTrack" style="transition:transform 0.5s ease;">
          <% sliders.forEach(function(slide, idx) { %>
          <div class="w-full h-full flex-shrink-0 relative rounded-2xl" style="background:linear-gradient(135deg,<%= slide.bg_color %> 0%,<%= slide.bg_color %>cc 100%);">
            <% if (slide.image_url) { %>
            <img src="<%= slide.image_url %>" alt="<%= slide.title %>" class="absolute inset-0 w-full h-full object-cover rounded-2xl">
            <div class="absolute inset-0 rounded-2xl" style="background:linear-gradient(to top,rgba(0,0,0,0.75) 0%,rgba(0,0,0,0.1) 60%,transparent 100%);"></div>
            <% } %>
            <a href="<%= slide.link_url %>" class="absolute bottom-0 left-0 right-0 p-6">
              <p class="text-white text-xs font-semibold uppercase tracking-widest mb-1 opacity-80">Özel Fırsat</p>
              <h3 class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight"><%= slide.title %></h3>
              <% if (slide.subtitle) { %><p class="text-white text-sm opacity-80 mb-3 line-clamp-1"><%= slide.subtitle %></p><% } %>
              <span class="inline-flex items-center gap-2 bg-white font-bold px-4 py-2 rounded-xl text-sm" style="color:<%= slide.bg_color %>;">
                Kupona Git
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </span>
            </a>
          </div>
          <% }) %>
        </div>
        <button onclick="sliderMove(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white bg-opacity-90 hover:bg-opacity-100 shadow-lg flex items-center justify-center transition z-10">
          <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button onclick="sliderMove(1)" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white bg-opacity-90 hover:bg-opacity-100 shadow-lg flex items-center justify-center transition z-10">
          <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </button>
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="sliderDots">
          <% sliders.forEach(function(_, idx) { %>
          <button onclick="sliderGoTo(<%= idx %>)" class="slider-dot w-2.5 h-2.5 rounded-full bg-white transition-all" style="opacity:<%= idx===0?'1':'0.45' %>; transform:scale(<%= idx===0?'1.3':'1' %>);"></button>
          <% }) %>
        </div>
      </div>

      <!-- Brand list (right) -->
      <div class="hidden sm:flex flex-col bg-white rounded-2xl shadow border border-gray-100 overflow-hidden flex-shrink-0" style="width:150px;">
        <div class="px-3 py-2.5 flex-shrink-0" style="background:#1a1a2e;">
          <h3 class="text-white text-xs font-bold uppercase tracking-wide text-center">Markalar</h3>
        </div>
        <div class="overflow-y-auto flex-1">
          <% sliders.forEach(function(slide, idx) { %>
          <%
            var storeSlug = '';
            var m = slide.link_url ? slide.link_url.match(/\/magaza\/([^\/]+)/) : null;
            if (m) storeSlug = m[1];
          %>
          <button onclick="sliderBrandClick(<%= idx %>)" class="brand-btn w-full flex flex-col items-center gap-1.5 px-2 py-3 border-b border-gray-50 hover:bg-orange-50 transition text-center" id="brand-btn-<%= idx %>" style="<%= idx===0 ? 'background:#fff7ed;' : '' %>">
            <div class="relative w-10 h-10 rounded-xl overflow-hidden border border-gray-100 flex-shrink-0">
              <div class="absolute inset-0 flex items-center justify-center text-white text-sm font-bold" style="background:<%= slide.bg_color || '#FF6B00' %>;"><%= (slide.title||'K').charAt(0) %></div>
              <% if (storeSlug) { %>
              <img src="https://logo.clearbit.com/<%= storeSlug %>.com" alt="" class="absolute inset-0 w-full h-full object-contain p-0.5 bg-white" onerror="this.style.display='none'">
              <% } %>
            </div>
            <span class="text-xs font-semibold text-gray-700 leading-tight line-clamp-2" style="font-size:10px;"><%= (slide.store_name_real || slide.title || '').split(' ').slice(0,2).join(' ') %></span>
          </button>
          <% }) %>
        </div>
      </div>

    </div>
  </div>
</section>
<% } %>

<!-- Main content + Right sidebar -->
<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex gap-6 items-start">

    <!-- Main column -->
    <div class="flex-1 min-w-0 space-y-6">

      <!-- 3-Tab Brand Section -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="flex flex-wrap gap-1 mb-6 bg-gray-100 rounded-2xl p-1.5 w-fit">
          <button class="tab-btn px-5 py-2 rounded-xl text-sm font-semibold transition text-white" data-tab="popular" style="background:#FF6B00;">Popüler İndirim Kodları</button>
          <button class="tab-btn px-5 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="new">En Yeni</button>
          <button class="tab-btn px-5 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="expiring">Kaçıyor</button>
        </div>
        <div id="tab-popular" class="tab-content">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
            <% (popularBrands || []).forEach(function(store) { %>
            <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-orange-50 border border-transparent hover:border-orange-200 transition">
              <div class="relative w-14 h-14 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
                <div class="absolute inset-0 flex items-center justify-center text-white text-lg font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
                <% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><% } %>
              </div>
              <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
              <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
            </a>
            <% }) %>
          </div>
        </div>
        <div id="tab-new" class="tab-content hidden">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
            <% (newBrands || []).forEach(function(store) { %>
            <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-orange-50 border border-transparent hover:border-orange-200 transition">
              <div class="relative w-14 h-14 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
                <div class="absolute inset-0 flex items-center justify-center text-white text-lg font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
                <% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><% } %>
              </div>
              <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
              <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
            </a>
            <% }) %>
          </div>
        </div>
        <div id="tab-expiring" class="tab-content hidden">
          <% if ((expiringBrands||[]).length > 0) { %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
            <% expiringBrands.forEach(function(store) { %>
            <a href="/magaza/<%= store.slug %>" class="group relative flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-red-50 border border-transparent hover:border-red-200 transition">
              <span class="absolute top-2 right-2 text-xs bg-red-100 text-red-600 font-bold px-1.5 py-0.5 rounded-full">Son</span>
              <div class="relative w-14 h-14 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
                <div class="absolute inset-0 flex items-center justify-center text-white text-lg font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
                <% if (store.logo_url) { %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><% } %>
              </div>
              <span class="text-xs font-semibold text-gray-800 text-center truncate w-full"><%= store.name %></span>
              <span class="text-xs text-red-400 mt-0.5"><% if(store.earliest_expiry){%><%= new Date(store.earliest_expiry).toLocaleDateString('tr-TR') %><%}%></span>
            </a>
            <% }) %>
          </div>
          <% } else { %>
          <div class="text-center py-10 text-gray-400">
            <p class="text-sm">Yakında sona erecek kupon bulunmuyor.</p>
          </div>
          <% } %>
        </div>
        <div class="mt-6 text-center">
          <a href="/magazalar" class="inline-flex items-center gap-2 px-6 py-2.5 border-2 rounded-xl font-semibold text-sm transition hover:bg-orange-50" style="border-color:#FF6B00;color:#FF6B00;">
            Tüm Markaları Gör <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Testimonials -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-1">Kullanıcılar Bizim İçin Ne Demiş?</h2>
        <p class="text-gray-500 text-sm mb-6">Binlerce kullanıcının deneyimini okuyun.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
            <div class="flex gap-0.5 mb-3">
              <% for(var i=0;i<5;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">&ldquo;Her ay ortalama %20 tasarruf ediyorum. Hepsini burada buluyorum!&rdquo;</p>
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#FF6B00;">A</div>
              <div><p class="text-sm font-semibold text-gray-800">Ayşe K.</p><p class="text-xs text-gray-400">İstanbul</p></div>
            </div>
          </div>
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
            <div class="flex gap-0.5 mb-3">
              <% for(var i=0;i<5;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">&ldquo;Doğrulanmış kupon rozeti çok işe yarıyor. Artık geçersiz kuponlarla vakit kaybetmiyorum.&rdquo;</p>
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#1a1a2e;">M</div>
              <div><p class="text-sm font-semibold text-gray-800">Mehmet Y.</p><p class="text-xs text-gray-400">Ankara</p></div>
            </div>
          </div>
          <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
            <div class="flex gap-0.5 mb-3">
              <% for(var i=0;i<4;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%><svg class="w-4 h-4 text-gray-200" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">&ldquo;Marka bildirim sistemi mükemmel. Hiçbir fırsat kaçmıyor.&rdquo;</p>
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#FF6B00;">Z</div>
              <div><p class="text-sm font-semibold text-gray-800">Zeynep A.</p><p class="text-xs text-gray-400">İzmir</p></div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Sıkça Sorulan Sorular</h2>
        <div class="space-y-2">
          <details class="bg-gray-50 rounded-xl border border-gray-100 group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-800 list-none text-sm">Kupon kodu nasıl kullanılır?<svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-180" style="color:#FF6B00;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">Kodu kopyaladıktan sonra mağaza ödeme sayfasındaki &ldquo;İndirim Kodu&rdquo; alanına yapıştırıp uygulaya tıklayın; indirim otomatik düşülecektir.</div>
          </details>
          <details class="bg-gray-50 rounded-xl border border-gray-100 group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-800 list-none text-sm">Kuponlar gerçekten çalışıyor mu?<svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-180" style="color:#FF6B00;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">Evet! Tüm kuponlarımız düzenli kontrol edilir. &ldquo;Doğrulanmış&rdquo; rozetli kuponlar bizzat test edilmiştir.</div>
          </details>
          <details class="bg-gray-50 rounded-xl border border-gray-100 group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-800 list-none text-sm">Belirli bir markanın bildirimlerini nasıl alabilirim?<svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-180" style="color:#FF6B00;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">Marka sayfasındaki &ldquo;Bildirim Al&rdquo; formunu kullanarak o markaya özel e-posta bildirimleri alabilirsiniz.</div>
          </details>
        </div>
      </div>

      <!-- Kuponluk Nedir? -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Kuponluk.com Nedir?</h2>
        <p class="text-gray-600 text-sm leading-relaxed">Türkiye'nin en kapsamlı kupon ve indirim kodu platformudur. Yüzlerce mağazadan derlenen binlerce aktif kupon kodu ile alışverişlerinizde ciddi tasarruflar elde edin.</p>
        <details class="group mt-4">
          <summary class="cursor-pointer font-semibold inline-flex items-center gap-1.5 list-none select-none text-sm" style="color:#FF6B00;">
            Daha fazla oku
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-gray-600 text-sm leading-relaxed space-y-3">
            <p>Kuponluk.com; kupon kodları, yüzde indirimler, ücretsiz kargo kampanyaları, hediye ürün fırsatları ve banka kampanyaları olmak üzere altı ana kategoride fırsatlar sunar.</p>
            <p>Her kupon editoryel ekibimizce incelenir. &ldquo;Doğrulanmış&rdquo; rozetli kuponlar bizzat test edilerek sisteme eklenir. Favori markanızı takip ederek yeni kupon geldiğinde anında bildirim alabilirsiniz.</p>
            <p>Kuponluk.com tamamen ücretsizdir; kayıt olmadan da kupon kullanabilir, kayıt olarak ise kuponları kaydedebilir ve kendi kuponlarınızı gönderebilirsiniz.</p>
          </div>
        </details>
      </div>

      <!-- 4 Feature Icons -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-3" style="background:#FFF3E8;">
              <svg class="w-6 h-6" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">Doğrulanmış Kuponlar</h3>
            <p class="text-xs text-gray-500">Test edilip onaylanmış kuponlar.</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-3" style="background:#FFF3E8;">
              <svg class="w-6 h-6" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">Marka Bildirimleri</h3>
            <p class="text-xs text-gray-500">Yeni kupon gelince anında haber al.</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-3" style="background:#FFF3E8;">
              <svg class="w-6 h-6" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="font-bold text-gray-800 text-sm mb-1">Kolay Kullanım</h3>
            <p class="text-xs text-gray-500">Bir tıkla kopyala ve tasarruf et.</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-3" style="background:#FFF3E8;">
