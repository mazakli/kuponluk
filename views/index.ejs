<!-- MAIN CONTENT -->
<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">

  <!-- Brand Tabs -->
  <div class="bg-white rounded-2xl shadow border-2 border-gray-300 p-6">
    <div class="flex flex-wrap gap-1 mb-6 bg-gray-100 rounded-2xl p-1.5 w-fit">
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-white" data-tab="popular" style="background:#1a1a2e;">Pop&#xFC;ler &#x130;ndirim Kodlar&#x131;</button>
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="new">En Yeni</button>
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="expiring">Ka&#xE7;&#x131;yor</button>
    </div>

    <div id="tab-popular" class="tab-content">
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% (popularBrands||[]).forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:bg-orange-50 border-2 border-transparent hover:border-orange-200 transition">
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2" style="background:#FF6B00;">
            <div class="absolute inset-0 flex items-center justify-center"><span class="text-white text-base font-extrabold"><%= (store.name||'K').charAt(0).toUpperCase() %></span></div>
            <% if(store.logo_url){ %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain bg-white p-1.5" onerror="if(this.src.indexOf('unavatar')>-1){this.src='https://www.google.com/s2/favicons?domain='+this.src.replace('https://unavatar.io/','')+'&sz=128';}else{this.style.display='none';}"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
          <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
        </a>
        <% }) %>
      </div>
    </div>

    <div id="tab-new" class="tab-content hidden">
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% (newBrands||[]).forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:bg-orange-50 border-2 border-transparent hover:border-orange-200 transition">
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2" style="background:#FF6B00;">
            <div class="absolute inset-0 flex items-center justify-center"><span class="text-white text-base font-extrabold"><%= (store.name||'K').charAt(0).toUpperCase() %></span></div>
            <% if(store.logo_url){ %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain bg-white p-1.5" onerror="if(this.src.indexOf('unavatar')>-1){this.src='https://www.google.com/s2/favicons?domain='+this.src.replace('https://unavatar.io/','')+'&sz=128';}else{this.style.display='none';}"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
          <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
        </a>
        <% }) %>
      </div>
    </div>

    <div id="tab-expiring" class="tab-content hidden">
      <% if((expiringBrands||[]).length>0){ %>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% expiringBrands.forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group relative flex flex-col items-center p-3 rounded-2xl bg-gray-50 border-2 border-transparent hover:border-red-200 transition">
          <span class="absolute top-1.5 right-1.5 text-xs bg-red-100 text-red-600 font-bold px-1.5 py-0.5 rounded-full" style="font-size:8px;">Son</span>
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2" style="background:#FF6B00;">
            <div class="absolute inset-0 flex items-center justify-center"><span class="text-white text-base font-extrabold"><%= (store.name||'K').charAt(0).toUpperCase() %></span></div>
            <% if(store.logo_url){ %><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain bg-white p-1.5" onerror="if(this.src.indexOf('unavatar')>-1){this.src='https://www.google.com/s2/favicons?domain='+this.src.replace('https://unavatar.io/','')+'&sz=128';}else{this.style.display='none';}"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 text-center truncate w-full"><%= store.name %></span>
          <span class="text-xs text-red-400 mt-0.5"><% if(store.earliest_expiry){%><%= new Date(store.earliest_expiry).toLocaleDateString('tr-TR') %><%}%></span>
        </a>
        <% }) %>
      </div>
      <% }else{ %>
      <div class="text-center py-10 text-gray-400"><p class="text-sm">Yak&#x131;nda sona erecek kupon bulunmuyor.</p></div>
      <% } %>
    </div>

    <div class="mt-6 text-center">
      <a href="/magazalar" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-semibold text-sm text-white transition hover:opacity-90" style="background:#1a1a2e;">
        T&#xFC;m Markalara G&#xF6;z At
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

</div>

