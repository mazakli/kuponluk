<!-- FEATURE ICONS -->
<section class="py-5 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="flex flex-col items-center">
        <div class="w-11 h-11 rounded-2xl flex items-center justify-center mb-2" style="background:#FFF3E8;"><svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
        <h3 class="font-bold text-gray-800 text-sm mb-0.5">Do&#x11F;rulanm&#x131;&#x15F; Kuponlar</h3>
        <p class="text-xs text-gray-500">Test edilip onaylanm&#x131;&#x15F; kuponlar.</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-11 h-11 rounded-2xl flex items-center justify-center mb-2" style="background:#FFF3E8;"><svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg></div>
        <h3 class="font-bold text-gray-800 text-sm mb-0.5">Marka Bildirimleri</h3>
        <p class="text-xs text-gray-500">Yeni kupon gelince an&#x131;nda haber al.</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-11 h-11 rounded-2xl flex items-center justify-center mb-2" style="background:#FFF3E8;"><svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
        <h3 class="font-bold text-gray-800 text-sm mb-0.5">Kolay Kullan&#x131;m</h3>
        <p class="text-xs text-gray-500">Bir t&#x131;kla kopyala ve tasarruf et.</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="w-11 h-11 rounded-2xl flex items-center justify-center mb-2" style="background:#FFF3E8;"><svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></div>
        <h3 class="font-bold text-gray-800 text-sm mb-0.5">Tamamen &#xDC;cretsiz</h3>
        <p class="text-xs text-gray-500">Kay&#x131;t olmadan da kullanabilirsiniz.</p>
      </div>
    </div>
  </div>
</section>

<script>
var _sc=0,_st=<%= sliders?sliders.length:0 %>,_si;
function sliderGoTo(idx){
  _sc=(((_st+idx%_st)%_st));
  document.getElementById('sliderTrack').style.transform='translateX(-'+(_sc*100)+'%)';
  document.querySelectorAll('.slider-dot').forEach(function(d,i){
    d.style.opacity=i===_sc?'1':'0.55';
    d.style.width=i===_sc?'24px':'8px';
  });
}
function sliderMove(dir){sliderGoTo(_sc+dir);clearInterval(_si);if(_st>1)_si=setInterval(function(){sliderGoTo(_sc+1);},5000);}
if(_st>1)_si=setInterval(function(){sliderGoTo(_sc+1);},5000);

document.querySelectorAll('.tab-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.tab-btn').forEach(function(b){b.style.background='';b.style.color='#4b5563';});
    this.style.background='#1a1a2e';this.style.color='white';
    document.querySelectorAll('.tab-content').forEach(function(c){c.classList.add('hidden');});
    var t=document.getElementById('tab-'+this.dataset.tab);
    if(t)t.classList.remove('hidden');
  });
});
</script>

<%- include('partials/footer') %>
</body>
</html>
