<script>
var _sc = 0, _st = <%= sliders ? sliders.length : 0 %>, _si;
function sliderGoTo(idx) {
  _sc = ((_st + idx % _st) % _st);
  var t = document.getElementById('sliderTrack');
  if (t) t.style.transform = 'translateX(-' + (_sc * 100) + '%)';
  document.querySelectorAll('.slider-dot').forEach(function(d,i){d.style.opacity=i===_sc?'1':'0.45';d.style.transform=i===_sc?'scale(1.3)':'scale(1)';});
  document.querySelectorAll('.brand-btn').forEach(function(b,i){b.style.background=i===_sc?'#fff7ed':'';})
}
function sliderMove(dir){sliderGoTo(_sc+dir);clearInterval(_si);if(_st>1)_si=setInterval(function(){sliderGoTo(_sc+1);},5000);}
function sliderBrandClick(idx){sliderGoTo(idx);clearInterval(_si);if(_st>1)_si=setInterval(function(){sliderGoTo(_sc+1);},5000);}
if(_st>1)_si=setInterval(function(){sliderGoTo(_sc+1);},5000);

document.querySelectorAll('.tab-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.tab-btn').forEach(function(b){b.style.background='';b.style.color='#4b5563';});
    this.style.background='#FF6B00';this.style.color='white';
    document.querySelectorAll('.tab-content').forEach(function(c){c.classList.add('hidden');});
    var t=document.getElementById('tab-'+this.dataset.tab);
    if(t)t.classList.remove('hidden');
  });
});
</script>

