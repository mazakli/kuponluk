<!-- MAIN CONTENT -->
<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">

  <!-- Brand Tabs -->
  <div class="bg-white rounded-2xl shadow border-2 border-gray-200 p-6">
    <div class="flex flex-wrap gap-1 mb-6 bg-gray-100 rounded-2xl p-1.5 w-fit">
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-white" data-tab="popular" style="background:#FF6B00;">Pop&#xFC;ler &#x130;ndirim Kodlar&#x131;</button>
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="new">En Yeni</button>
      <button class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition text-gray-600" data-tab="expiring">Ka&#xE7;&#x131;yor</button>
    </div>

    <div id="tab-popular" class="tab-content">
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% (popularBrands||[]).forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-orange-50 border border-transparent hover:border-orange-200 transition">
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
            <div class="absolute inset-0 flex items-center justify-center text-white text-base font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
            <% if(store.logo_url){%><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
          <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
        </a>
        <% }) %>
      </div>
    </div>

    <div id="tab-new" class="tab-content hidden">
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% (newBrands||[]).forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-orange-50 border border-transparent hover:border-orange-200 transition">
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
            <div class="absolute inset-0 flex items-center justify-center text-white text-base font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
            <% if(store.logo_url){%><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 group-hover:text-orange-600 text-center truncate w-full leading-tight"><%= store.name %></span>
          <span class="text-xs text-gray-400 mt-0.5"><%= store.active_coupons||0 %> kupon</span>
        </a>
        <% }) %>
      </div>
    </div>

    <div id="tab-expiring" class="tab-content hidden">
      <% if((expiringBrands||[]).length>0){ %>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3">
        <% expiringBrands.forEach(function(store){ %>
        <a href="/magaza/<%= store.slug %>" class="group relative flex flex-col items-center p-3 rounded-2xl bg-gray-50 hover:shadow-md hover:bg-red-50 border border-transparent hover:border-red-200 transition">
          <span class="absolute top-1.5 right-1.5 text-xs bg-red-100 text-red-600 font-bold px-1.5 py-0.5 rounded-full" style="font-size:8px;">Son</span>
          <div class="relative w-12 h-12 rounded-2xl overflow-hidden flex-shrink-0 mb-2 border border-gray-100">
            <div class="absolute inset-0 flex items-center justify-center text-white text-base font-extrabold" style="background:#FF6B00;"><%= (store.name||'K').charAt(0).toUpperCase() %></div>
            <% if(store.logo_url){%><img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain p-1.5 bg-white" onerror="this.style.display='none'"/><%}%>
          </div>
          <span class="text-xs font-semibold text-gray-800 text-center truncate w-full"><%= store.name %></span>
          <span class="text-xs text-red-400 mt-0.5"><% if(store.earliest_expiry){%><%= new Date(store.earliest_expiry).toLocaleDateString('tr-TR') %><%}%></span>
        </a>
        <% }) %>
      </div>
      <% }else{ %>
      <div class="text-center py-10 text-gray-400"><p class="text-sm">Yak&#x131;nda sona erecek kupon bulunmuyor.</p></div>
      <% } %>
    </div>

    <div class="mt-6 text-center">
      <a href="/magazalar" class="inline-flex items-center gap-2 px-6 py-2.5 border-2 rounded-xl font-semibold text-sm transition hover:bg-orange-50" style="border-color:#FF6B00;color:#FF6B00;">
        T&#xFC;m Markalara G&#xF6;z At
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <!-- ONE CIKAN ILANLAR -->
  <% if (featuredListings && featuredListings.length > 0) { %>
  <div class="bg-white rounded-2xl shadow border-2 border-gray-200 p-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-gray-800">&#xD6;ne &#xC7;&#x131;kan &#x130;lanlar</h2>
      <a href="/ilanlar" class="text-sm font-semibold flex items-center gap-1 hover:opacity-80 transition" style="color:#FF6B00;">
        T&#xFC;m&#xFC;n&#xFC; G&#xF6;r
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <% featuredListings.forEach(function(listing){ %>
      <a href="/ilanlar/<%= listing.id %>" class="group flex flex-col p-4 rounded-xl border-2 border-gray-100 hover:border-orange-300 hover:bg-orange-50 transition">
        <div class="flex items-start gap-3 mb-3">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-sm flex-shrink-0" style="background:#1a1a2e;">
            <%= (listing.store_name||listing.title||'K').charAt(0).toUpperCase() %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-gray-400 truncate mb-0.5"><%= listing.store_name || 'Kullanıcı İlanı' %></p>
            <h3 class="text-sm font-semibold text-gray-800 group-hover:text-orange-600 transition leading-snug" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= listing.title %></h3>
          </div>
        </div>
        <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-100">
          <% if(listing.discount_value){ %>
          <span class="text-xs font-bold text-white px-2.5 py-1 rounded-full" style="background:#FF6B00;">
            <%= listing.discount_value %><% if(listing.discount_type==='percentage'){ %>%<% }else{ %> TL<% } %> &#x130;ndirim
          </span>
          <% }else{ %>
          <span class="text-xs font-medium text-gray-400">&#x130;lan</span>
          <% } %>
          <span class="text-xs text-gray-400"><%= listing.seller_name ? '@'+listing.seller_name : '' %></span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- TESTIMONIALS -->
  <div class="bg-white rounded-2xl shadow border-2 border-gray-200 p-6">
    <h2 class="text-xl font-bold text-gray-800 mb-1 text-center">Kullan&#x131;c&#x131;lar Bizim &#x130;&#xE7;in Ne Demi&#x15F;?</h2>
    <p class="text-gray-500 text-sm mb-6 text-center">Binlerce kullan&#x131;c&#x131;n&#x131;n deneyimini okuyun.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-gray-50 rounded-xl p-5 border-2 border-gray-100">
        <div class="flex gap-0.5 mb-3"><% for(var i=0;i<5;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%></div>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">&ldquo;Her ay ortalama %20 tasarruf ediyorum. Hepsini burada buluyorum!&rdquo;</p>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#FF6B00;">A</div>
          <div><p class="text-sm font-semibold text-gray-800">Ay&#x15F;e K.</p><p class="text-xs text-gray-400">&#x130;stanbul</p></div>
        </div>
      </div>
      <div class="bg-gray-50 rounded-xl p-5 border-2 border-gray-100">
        <div class="flex gap-0.5 mb-3"><% for(var i=0;i<5;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%></div>
        <p class="text-gray-600 text-sm leading-relaxed mb-4">&ldquo;Do&#x11F;rulanm&#x131;&#x15F; kupon rozeti &#xE7;ok i&#x15F;e yar&#x131;yor. Art&#x131;k ge&#xE7;ersiz kuponlarla vakit kaybetmiyorum.&rdquo;</p>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#1a1a2e;">M</div>
          <div><p class="text-sm font-semibold text-gray-800">Mehmet Y.</p><p class="text-xs text-gray-400">Ankara</p></div>
        </div>
      </div>
      <div class="bg-gray-50 rounded-xl p-5 border-2 border-gray-100">
        <div class="flex gap-0.5 mb-3"><% for(var i=0;i<4;i++){%><svg class="w-4 h-4" style="color:#FF6B00" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><%}%><svg class="w-4 h-4 text-gray-200" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg></div>
