<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- SLIDER -->
<% if (sliders && sliders.length > 0) { %>
<section class="py-4 px-4" style="background:#f3f4f6">
  <div class="max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-2xl shadow-lg" id="mainSlider" style="height:clamp(220px,30vw,440px);background:#1a1a2e;">
      <div class="flex h-full" id="sliderTrack" style="transition:transform 0.5s ease;">
        <% sliders.forEach(function(slide,idx){ %>
        <div class="w-full h-full flex-shrink-0 relative" style="background:linear-gradient(135deg,<%= slide.bg_color||'#FF6B00' %> 0%,<%= slide.bg_color||'#FF6B00' %>bb 100%);">
          <% if(slide.image_url){ %>
          <img src="<%= slide.image_url %>" alt="<%= slide.title %>" class="absolute inset-0 w-full h-full object-cover">
          <div class="absolute inset-0" style="background:linear-gradient(to top,rgba(0,0,0,0.78) 0%,rgba(0,0,0,0.08) 55%,transparent 100%);"></div>
          <% } %>
          <a href="<%= slide.link_url %>" class="absolute inset-0 flex flex-col justify-end p-4 sm:p-8">
            <p class="text-white text-xs font-bold uppercase tracking-widest mb-1 opacity-75">&#xD6;zel F&#x131;rsat</p>
            <h3 class="text-xl sm:text-3xl md:text-4xl font-extrabold text-white mb-2 leading-tight line-clamp-2"><%= slide.title %></h3>
            <% if(slide.subtitle){ %><p class="text-white text-sm opacity-80 mb-4 max-w-lg"><%= slide.subtitle %></p><% } %>
            <span class="self-start inline-flex items-center gap-2 font-bold px-6 py-2.5 rounded-xl text-sm transition hover:opacity-90" style="background:#FF6B00;color:#fff;">
              Kupona Git
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        </div>
        <% }) %>
      </div>
      <button onclick="sliderMove(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white bg-opacity-90 shadow-lg flex items-center justify-center transition hover:bg-opacity-100 z-10">
        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button onclick="sliderMove(1)" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white bg-opacity-90 shadow-lg flex items-center justify-center transition hover:bg-opacity-100 z-10">
        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="sliderDots">
        <% sliders.forEach(function(_,idx){ %>
        <button onclick="sliderGoTo(<%= idx %>)" class="slider-dot rounded-full bg-white transition-all" style="width:<%= idx===0?'24px':'8px' %>;height:8px;opacity:<%= idx===0?'1':'0.55' %>;"></button>
        <% }) %>
      </div>
    </div>
    <p class="text-xs text-gray-400 text-center mt-2">&#xD6;nerilen slider g&#xF6;rsel boyutu: <strong>1400 &times; 520 px</strong> &mdash; JPEG veya WebP format&#x131;, maks. 200 KB</p>
  </div>
</section>
<% } %>

