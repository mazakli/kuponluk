<script>
var _sliderCurrent = 0, _sliderTotal = <%= sliders ? sliders.length : 0 %>, _sliderTimer;
function sliderGoTo(idx) {
  _sliderCurrent = ((idx % _sliderTotal) + _sliderTotal) % _sliderTotal;
  var t = document.getElementById('sliderTrack');
  if (t) t.style.transform = 'translateX(-' + (_sliderCurrent * 100) + '%)';
  document.querySelectorAll('.slider-dot').forEach(function(d, i) {
    d.style.opacity = i === _sliderCurrent ? '1' : '0.45';
    d.style.transform = i === _sliderCurrent ? 'scale(1.3)' : 'scale(1)';
  });
}
function sliderMove(dir) { sliderGoTo(_sliderCurrent + dir); resetSliderTimer(); }
function resetSliderTimer() {
  clearInterval(_sliderTimer);
  if (_sliderTotal > 1) _sliderTimer = setInterval(function(){ sliderGoTo(_sliderCurrent + 1); }, 5000);
}
if (_sliderTotal > 1) resetSliderTimer();

document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.style.background=''; b.style.color='#4b5563'; });
    this.style.background = '#FF6B00'; this.style.color = 'white';
    document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.add('hidden'); });
    var t = document.getElementById('tab-' + this.dataset.tab);
    if (t) t.classList.remove('hidden');
  });
});
</script>

