<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- SLIDER (full width) -->
<% if (sliders && sliders.length > 0) { %>
<section class="py-4 px-4" style="background:#f3f4f6">
  <div class="max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-2xl shadow-lg bg-gray-200" id="mainSlider" style="aspect-ratio:21/7;max-height:300px;">
      <div class="flex h-full" id="sliderTrack" style="transition:transform 0.5s ease;">
        <% sliders.forEach(function(slide,idx){ %>
        <div class="w-full h-full flex-shrink-0 relative rounded-2xl" style="background:linear-gradient(135deg,<%= slide.bg_color||'#FF6B00' %> 0%,<%= slide.bg_color||'#FF6B00' %>cc 100%);">
          <% if(slide.image_url){ %>
          <img src="<%= slide.image_url %>" alt="<%= slide.title %>" class="absolute inset-0 w-full h-full object-cover rounded-2xl">
          <div class="absolute inset-0 rounded-2xl" style="background:linear-gradient(to top,rgba(0,0,0,0.72) 0%,rgba(0,0,0,0.1) 60%,transparent 100%);"></div>
          <% } %>
          <a href="<%= slide.link_url %>" class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-white text-xs font-semibold uppercase tracking-widest mb-0.5 opacity-80">&#xD6;zel F&#x131;rsat</p>
            <h3 class="text-xl md:text-2xl font-extrabold text-white mb-1 leading-tight"><%= slide.title %></h3>
            <% if(slide.subtitle){ %><p class="text-white text-sm opacity-80 mb-3 line-clamp-1"><%= slide.subtitle %></p><% } %>
            <span class="inline-flex items-center gap-1.5 bg-white font-bold px-5 py-2 rounded-xl text-sm" style="color:<%= slide.bg_color||'#FF6B00' %>;">
              Kupona Git
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        </div>
        <% }) %>
      </div>
      <button onclick="sliderMove(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white bg-opacity-90 shadow-lg flex items-center justify-center transition z-10">
        <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button onclick="sliderMove(1)" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white bg-opacity-90 shadow-lg flex items-center justify-center transition z-10">
        <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10" id="sliderDots">
        <% sliders.forEach(function(_,idx){ %>
        <button onclick="sliderGoTo(<%= idx %>)" class="slider-dot w-2 h-2 rounded-full bg-white transition-all" style="opacity:<%= idx===0?'1':'0.45' %>;transform:scale(<%= idx===0?'1.3':'1' %>);"></button>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>

