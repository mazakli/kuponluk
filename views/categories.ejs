<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
var catIconMap = {
  'moda-giyim':        '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>',
  'elektronik':        '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>',
  'yemek-restoran':    '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
  'seyahat':           '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>',
  'kozmetik-guzellik': '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>',
  'ev-yasam':          '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 22V12h6v10"/></svg>',
  'spor-outdoor':      '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  'kitap-egitim':      '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>',
  'oyun-eglence':      '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>',
  'market-supermarket':'<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>',
  'sigorta-finans':    '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
  'teknoloji-yazilim': '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>'
};
var defaultCatIcon = '<svg class="w-7 h-7" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>';
%>

<div class="max-w-6xl mx-auto px-4 py-8">

  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium">Kategoriler</span>
  </nav>

  <div class="mb-8 text-center">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">T&#xFC;m Kategoriler</h1>
    <p class="text-gray-500">Al&#x131;&#x15F;veri&#x15F; yapt&#x131;&#x11F;&#x131;n&#x131;z kategoriyi se&#xE7;in ve en iyi kuponlar&#x131; ke&#x15F;fedin.</p>
  </div>

  <% if (categories && categories.length > 0) { %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-5">
    <% categories.forEach(function(cat) { %>
    <a href="/kategori/<%= cat.slug %>" class="group rounded-2xl overflow-hidden shadow hover:shadow-xl transition border-2 border-gray-300 hover:border-orange-300 flex flex-col bg-white">
      <div class="h-1.5 w-full" style="background:#FF6B00;"></div>
      <div class="flex-1 p-6 flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-3" style="background:#FFF3E8;">
          <%- catIconMap[cat.slug] || defaultCatIcon %>
        </div>
        <h3 class="text-base font-bold text-gray-800 group-hover:text-orange-600 transition mb-2"><%= cat.name %></h3>
        <div class="flex gap-6 mt-1">
          <div class="text-center">
            <div class="text-xl font-extrabold" style="color:#1a1a2e;"><%= cat.coupon_count || 0 %></div>
            <div class="text-xs text-gray-400">Kupon</div>
          </div>
          <div class="text-center">
            <div class="text-xl font-extrabold" style="color:#1a1a2e;"><%= cat.store_count || 0 %></div>
            <div class="text-xs text-gray-400">Ma&#x11F;aza</div>
          </div>
        </div>
        <span class="mt-4 inline-block text-sm font-semibold text-white px-4 py-1.5 rounded-full transition group-hover:opacity-90" style="background:#1a1a2e;">
          Kuponlar&#x131; G&#xF6;r
        </span>
      </div>
    </a>
    <% }); %>
  </div>
  <% } else { %>
  <div class="bg-white rounded-2xl border-2 border-gray-300 shadow p-16 text-center">
    <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    <h3 class="text-xl font-semibold text-gray-700 mb-2">Kategori Bulunamad&#x131;</h3>
    <p class="text-gray-500">Hen&#xFC;z kategori eklenmemi&#x15F;.</p>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
</body>
</html>
