<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-6xl mx-auto px-4 py-8">

  <!-- Breadcrumb + Title Box -->
  <div class="bg-white rounded-2xl p-5 mb-6" style="border: 3px solid #e2e8f0;">
    <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-3">
      <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-800 font-medium">Ma&#x11F;azalar</span>
    </nav>
    <h1 class="text-2xl font-extrabold text-gray-900 mb-1">T&#xFC;m Ma&#x11F;azalar</h1>
    <p class="text-gray-500 text-sm">Y&#xFC;zlerce ma&#x11F;azan&#x131;n indirim kuponlar&#x131;na g&#xF6;z at&#x131;n.</p>
  </div>

  <!-- Category Filters -->
  <% if (categories && categories.length > 0) { %>
  <div class="bg-white rounded-2xl p-5 mb-6" style="border: 3px solid #e2e8f0;">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-sm font-semibold text-gray-600">Kategori:</span>
      <a href="/magazalar" class="text-xs px-3 py-1.5 rounded-full font-medium transition <%= !catSlug ? 'text-white' : 'bg-gray-100 text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" style="<%= !catSlug ? 'background:#FF6B00;' : '' %>">T&#xFC;m&#xFC;</a>
      <% categories.forEach(function(cat) { %>
      <a href="/magazalar?kategori=<%= cat.slug %>" class="text-xs px-3 py-1.5 rounded-full font-medium transition <%= catSlug === cat.slug ? 'text-white' : 'bg-gray-100 text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" style="<%= catSlug === cat.slug ? 'background:#FF6B00;' : '' %>">
        <%= cat.name %>
      </a>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- Stores Grid -->
  <% if (stores && stores.length > 0) { %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
    <% stores.forEach(function(store) { %>
    <a href="/magaza/<%= store.slug %>" class="bg-white rounded-2xl shadow hover:shadow-lg transition hover:border-orange-300 p-4 flex flex-col items-center text-center group" style="border: 3px solid #e2e8f0;">
      <div class="relative w-14 h-14 rounded-xl overflow-hidden mb-3 flex-shrink-0" style="background:#FF6B00;">
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-white text-2xl font-bold"><%= (store.name||'?').charAt(0).toUpperCase() %></span>
        </div>
        <% if (store.logo_url) { %>
        <img src="<%= store.logo_url %>" alt="<%= store.name %>" class="absolute inset-0 w-full h-full object-contain bg-white p-2" onerror="if(this.src.indexOf('unavatar')>-1){this.src='https://www.google.com/s2/favicons?domain='+this.src.replace('https://unavatar.io/','')+'&sz=128';}else{this.style.display='none';}" />
        <% } %>
      </div>
      <span class="text-sm font-semibold text-gray-700 group-hover:text-orange-600 transition truncate w-full text-center"><%= store.name %></span>
      <% if (store.category_name) { %><span class="text-xs text-gray-400 mt-1"><%= store.category_name %></span><% } %>
      <span class="inline-block mt-2 text-xs font-bold px-2 py-0.5 rounded-full" style="color:#FF6B00;background:#FFF3E8;"><%= store.active_coupons || store.coupon_count || 0 %> kupon</span>
    </a>
    <% }); %>
  </div>
  <% } else { %>
  <div class="bg-white rounded-2xl p-16 text-center" style="border: 3px solid #e2e8f0;">
    <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 00-1-1h-2a1 1 0 00-1 1v5m4 0H9"/></svg>
    <h3 class="text-xl font-semibold text-gray-700 mb-2">Ma&#x11F;aza Bulunamad&#x131;</h3>
    <p class="text-gray-500 mb-4">Se&#xE7;ili filtreler i&#xE7;in ma&#x11F;aza bulunamad&#x131;.</p>
    <a href="/magazalar" class="inline-block px-6 py-2.5 rounded-xl text-white font-semibold transition hover:opacity-90" style="background:#1a1a2e;">T&#xFC;m Ma&#x11F;azalar</a>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
</body>
</html>
