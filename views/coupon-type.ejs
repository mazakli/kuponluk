<%
function turkishSlugify(text) {
  return (text || '').toLowerCase()
    .replace(/ç/g,'c').replace(/ğ/g,'g').replace(/ı/g,'i').replace(/ö/g,'o').replace(/ş/g,'s').replace(/ü/g,'u')
    .replace(/â/g,'a').replace(/î/g,'i').replace(/û/g,'u')
    .replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,50);
}
%>
<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- Breadcrumb -->
<div class="max-w-6xl mx-auto px-4 pt-4">
  <div class="inline-flex items-center gap-1.5 bg-white border border-gray-200 rounded-xl px-4 py-2 text-sm">
    <a href="/" class="text-gray-500 hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium"><%= typeName %></span>
  </div>
</div>

<div class="mt-4 py-6 px-4" style="background:linear-gradient(135deg,#0d1b3e 0%,#1a3466 100%);">
  <div class="max-w-6xl mx-auto flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(255,255,255,0.12);">
      <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
    </div>
    <div>
      <h1 class="text-2xl font-extrabold text-white"><%= typeName %></h1>
      <p class="text-sm mt-0.5" style="color:rgba(255,255,255,0.6);"><%= typeDesc %></p>
    </div>
  </div>
</div>

<!-- Type Filter Tabs -->
<div class="bg-white border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 overflow-x-auto">
    <div class="flex gap-1 py-2">
      <a href="/kupon/kupon-kodu" class="flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition <%= typeSlug==='kupon-kodu'?'text-white':'text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" <%if(typeSlug==='kupon-kodu'){%>style="background:linear-gradient(135deg,#e55a04,#f97316)"<%}%>>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
        Kupon Kodu
      </a>
      <a href="/kupon/indirim" class="flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition <%= typeSlug==='indirim'?'text-white':'text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" <%if(typeSlug==='indirim'){%>style="background:linear-gradient(135deg,#e55a04,#f97316)"<%}%>>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M7 7a1 1 0 110-2 1 1 0 010 2zm10 10a1 1 0 110-2 1 1 0 010 2z"/></svg>
        İndirim
      </a>
      <a href="/kupon/hediye" class="flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition <%= typeSlug==='hediye'?'text-white':'text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" <%if(typeSlug==='hediye'){%>style="background:linear-gradient(135deg,#e55a04,#f97316)"<%}%>>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
        Hediye
      </a>
      <a href="/kupon/ucretsiz-kargo" class="flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition <%= typeSlug==='ucretsiz-kargo'?'text-white':'text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" <%if(typeSlug==='ucretsiz-kargo'){%>style="background:linear-gradient(135deg,#e55a04,#f97316)"<%}%>>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0H3m14 0h2"/></svg>
        Ücretsiz Kargo
      </a>
      <a href="/kupon/banka-kampanyalari" class="flex items-center gap-1.5 whitespace-nowrap px-4 py-2 rounded-lg text-sm font-semibold transition <%= typeSlug==='banka-kampanyalari'?'text-white':'text-gray-600 hover:bg-orange-50 hover:text-orange-600' %>" <%if(typeSlug==='banka-kampanyalari'){%>style="background:linear-gradient(135deg,#e55a04,#f97316)"<%}%>>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        Banka Kampanyaları
      </a>
    </div>
  </div>
</div>

<section class="py-8 px-4 bg-gray-50 min-h-[50vh]">
  <div class="max-w-6xl mx-auto">
    <% if (coupons && coupons.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <% coupons.forEach(function(coupon) { %>
      <div class="group bg-white rounded-2xl border-2 border-gray-100 hover:shadow-lg hover:border-orange-200 transition overflow-hidden flex flex-col cursor-pointer"
        onclick="openCouponModalFromCard(this)"
        data-coupon-id="<%= coupon.id %>"
        data-coupon-code="<%= coupon.code||'' %>"
        data-coupon-title="<%= coupon.title %>"
        data-store-url="<%= coupon.website_url||'' %>"
        data-store-name="<%= coupon.store_name %>"
        data-store-id="<%= coupon.store_id %>">
        <div class="px-5 pt-5 pb-4 flex-1">
          <div class="flex items-start gap-3 mb-3">
            <div class="relative w-10 h-10 rounded-xl overflow-hidden flex-shrink-0 border border-gray-100">
              <div class="absolute inset-0 flex items-center justify-center text-white text-sm font-bold" style="background:#f97316;"><%= (coupon.store_name||'K').charAt(0).toUpperCase() %></div>
              <img src="/uploads/brands/<%= coupon.store_slug %>.png" alt="" class="absolute inset-0 w-full h-full object-contain p-1 bg-white" onerror="this.style.display='none'">
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-gray-400 truncate"><%= coupon.store_name %></p>
              <h3 class="text-sm font-semibold text-gray-800 group-hover:text-orange-600 leading-snug line-clamp-2"><%= coupon.title %></h3>
            </div>
          </div>
          <% if (coupon.code) { %>
          <div class="relative overflow-hidden rounded-lg border-2 border-dashed border-orange-200" style="background:linear-gradient(90deg,#fff8f0,#ffede0);">
            <div class="px-3 py-2" style="visibility:hidden;">
              <span class="text-xs font-bold tracking-widest"><%= coupon.code %></span>
            </div>
            <div class="absolute inset-0 flex items-center justify-center gap-1">
              <svg class="w-3.5 h-3.5" style="color:#f97316" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
              <span class="text-xs font-bold" style="color:#f97316;">Kodu Gör</span>
            </div>
          </div>
          <% } else if (coupon.discount_value) { %>
          <div class="flex items-center gap-2 bg-green-50 rounded-lg px-3 py-2">
            <span class="text-sm font-bold text-green-700">
              <% if(coupon.discount_type==='percent'){%>%<%= coupon.discount_value %> İndirim<%}else if(coupon.discount_type==='fixed'){%><%= coupon.discount_value %> TL İndirim<%}else if(coupon.discount_type==='free_shipping'){%>Ücretsiz Kargo<%}else if(coupon.discount_type==='gift'){%>Hediye<%}else{%>İndirim<%}%>
            </span>
          </div>
          <% } %>
        </div>
        <div class="px-5 pb-4 flex items-center justify-between">
          <% if (coupon.is_verified) { %>
          <span class="flex items-center gap-1 text-xs text-green-600 font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Doğrulandı
          </span>
          <% } else { %>
          <span class="text-xs text-gray-400">Kullanıcı Kuponu</span>
          <% } %>
          <span class="text-xs text-gray-400"><%= coupon.use_count||0 %> kullanım</span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="text-center py-20">
      <svg class="w-16 h-16 mx-auto mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      <p class="text-gray-400 text-lg font-medium">Bu kategoride henüz kupon bulunmuyor.</p>
      <a href="/" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold hover:underline" style="color:#f97316;">Tüm Kupona Bak</a>
    </div>
    <% } %>
  </div>
</section>

<!-- MODAL -->
<div id="couponModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background:rgba(0,0,0,0.55);">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md relative flex flex-col" style="max-height:90vh;">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0" style="background:linear-gradient(135deg,#0d1b3e,#1a3466);">
      <h3 class="text-white font-bold text-lg" id="modalTitle">İndirim Kodu</h3>
      <button onclick="closeCouponModal()" class="text-white hover:text-orange-200 transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-6 space-y-4 overflow-y-auto">
      <div>
        <p class="text-xs text-gray-500 mb-1.5 font-medium">İndirim Kodunuz</p>
        <div class="flex items-center gap-2">
          <div class="flex-1 bg-orange-50 border-2 border-dashed border-orange-300 rounded-xl px-4 py-3 text-center">
            <span id="modalCode" class="text-2xl font-extrabold tracking-widest" style="color:#f97316;"></span>
          </div>
          <button onclick="copyModalCode()" class="flex flex-col items-center gap-0.5 px-3 py-2.5 rounded-xl border-2 border-orange-300 hover:bg-orange-50 transition">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span class="text-xs text-orange-500 font-semibold">Kopyala</span>
          </button>
        </div>
        <p id="copyMsg" class="text-xs text-green-600 mt-1 hidden">Kod kopyalandı!</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-4 border-2 border-gray-100">
        <p class="text-sm font-semibold text-gray-700 mb-3">Bu kuponu kullanabildiniz mi?</p>
        <div class="flex gap-3">
          <button onclick="submitFeedback(true)" id="feedbackYes" class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl border-2 border-green-200 text-green-700 font-semibold text-sm hover:bg-green-50 transition">Evet</button>
          <button onclick="submitFeedback(false)" id="feedbackNo" class="flex-1 flex items-center justify-center gap-2 py-2.5 rounded-xl border-2 border-red-200 text-red-600 font-semibold text-sm hover:bg-red-50 transition">Hayır</button>
        </div>
        <p id="feedbackMsg" class="text-xs text-center mt-2 hidden"></p>
      </div>
      <div class="bg-blue-50 rounded-xl p-4 border-2 border-blue-100">
        <p class="text-xs font-bold text-blue-700 mb-2">Nasıl Kullanılır?</p>
        <ol class="text-xs text-blue-600 space-y-1 list-none">
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">1</span> Kodu kopyalayın.</li>
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">2</span> Mağazada ürünlerinizi sepete ekleyin.</li>
          <li class="flex items-start gap-1.5"><span class="w-4 h-4 rounded-full bg-blue-200 text-blue-700 font-bold flex items-center justify-center flex-shrink-0 mt-0.5">3</span> Ödeme sayfasında &ldquo;İndirim Kodu&rdquo; alanına yapıştırın.</li>
        </ol>
      </div>
      <a id="modalStoreLink" href="#" target="_blank" rel="nofollow noopener" class="flex items-center justify-center gap-2 w-full py-3 rounded-xl text-white font-bold text-base transition hover:opacity-90" style="background:#16a34a;">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        Alışverişe Başla
      </a>
      <div class="border-t border-gray-100 pt-4">
        <p class="text-xs text-gray-500 mb-2">Yeni kuponlardan haberdar olmak ister misiniz?</p>
        <form id="modalSubForm" class="flex gap-2">
          <input type="hidden" name="store_id" id="modalStoreId" value=""/>
          <input type="email" name="email" placeholder="E-posta adresiniz" required value="<%= currentUser?currentUser.email:'' %>" class="flex-1 px-3 py-2 rounded-xl border-2 border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-orange-300"/>
          <button type="submit" class="text-white text-xs font-semibold px-4 py-2 rounded-xl hover:opacity-90 whitespace-nowrap transition" style="background:linear-gradient(135deg,#e55a04,#f97316);">Abone Ol</button>
        </form>
        <p id="modalSubMsg" class="text-xs mt-1 hidden"></p>
      </div>
    </div>
  </div>
</div>

<script>
var currentCouponCode='',currentStoreUrl='',currentCouponId='';
function openCouponModal(id,code,title,storeUrl,storeName,storeId){
  currentCouponCode=code;currentStoreUrl=storeUrl;currentCouponId=id;
  document.getElementById('modalTitle').textContent=title||(storeName+' İndirim Kodu');
  document.getElementById('modalCode').textContent=code||'—';
  document.getElementById('modalStoreLink').href=storeUrl||('#');
  document.getElementById('modalStoreId').value=storeId||'';
  document.getElementById('copyMsg').classList.add('hidden');
  document.getElementById('feedbackMsg').classList.add('hidden');
  document.getElementById('feedbackYes').style.background='';
  document.getElementById('feedbackNo').style.background='';
  var m=document.getElementById('couponModal');
  m.classList.remove('hidden');m.classList.add('flex');
}
function openCouponModalFromCard(el){
  var d=el.dataset;
  var url=new URL(window.location);
  url.searchParams.set('kupon',d.couponId);
  history.pushState({couponId:d.couponId},'',url.toString());
  openCouponModal(d.couponId,d.couponCode,d.couponTitle,d.storeUrl,d.storeName,d.storeId);
}
function closeCouponModal(){
  var m=document.getElementById('couponModal');
  m.classList.add('hidden');m.classList.remove('flex');
  var url=new URL(window.location);
  url.searchParams.delete('kupon');
  history.pushState({},'',url.toString());
}
document.getElementById('couponModal').addEventListener('click',function(e){if(e.target===this)closeCouponModal();});
window.addEventListener('popstate',function(){
  var cid=new URLSearchParams(window.location.search).get('kupon');
  if(cid){var el=document.querySelector('[data-coupon-id="'+cid+'"]');if(el)openCouponModal(el.dataset.couponId,el.dataset.couponCode,el.dataset.couponTitle,el.dataset.storeUrl,el.dataset.storeName,el.dataset.storeId);}
  else{var m=document.getElementById('couponModal');if(m){m.classList.add('hidden');m.classList.remove('flex');}}
});
(function(){var cid=new URLSearchParams(window.location.search).get('kupon');if(cid){var el=document.querySelector('[data-coupon-id="'+cid+'"]');if(el)setTimeout(function(){openCouponModal(el.dataset.couponId,el.dataset.couponCode,el.dataset.couponTitle,el.dataset.storeUrl,el.dataset.storeName,el.dataset.storeId);},50);}})();
function copyModalCode(){
  if(!currentCouponCode)return;
  navigator.clipboard.writeText(currentCouponCode).then(function(){
    var msg=document.getElementById('copyMsg');
    msg.classList.remove('hidden');
    setTimeout(function(){msg.classList.add('hidden');},2500);
  });
}
function submitFeedback(pos){
  var yb=document.getElementById('feedbackYes'),nb=document.getElementById('feedbackNo'),msg=document.getElementById('feedbackMsg');
  if(pos){yb.style.background='#dcfce7';nb.style.background='';msg.textContent='Teşekkürler!';msg.style.color='#16a34a';}
  else{nb.style.background='#fee2e2';yb.style.background='';msg.textContent='Üzgünüz, en kısa sürede güncelleyeceğiz.';msg.style.color='#dc2626';}
  msg.classList.remove('hidden');
  if(currentCouponId)fetch('/kupon/'+currentCouponId+'/kullan',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:''}).catch(function(){});
}
var msf=document.getElementById('modalSubForm');
if(msf)msf.addEventListener('submit',function(e){e.preventDefault();fetch('/marka-abone-ol',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(msf)).toString()}).then(function(r){return r.json();}).then(function(d){var m=document.getElementById('modalSubMsg');m.textContent=d.message;m.style.color=d.success?'#16a34a':'#dc2626';m.classList.remove('hidden');if(d.success)msf.querySelector('input[type=email]').value='';});});
</script>

<%- include('partials/footer') %>
</body>
</html>
