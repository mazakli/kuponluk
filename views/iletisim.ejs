<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-5xl mx-auto px-4 py-8">

  <!-- Breadcrumb + Title -->
  <div class="bg-white rounded-2xl p-6 mb-6" style="border: 3px solid #e2e8f0;">
    <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-3 flex-wrap">
      <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
      <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-800 font-medium">&#x130;leti&#x15F;im</span>
    </nav>
    <h1 class="text-gray-900 mb-1">&#x130;leti&#x15F;im</h1>
    <p class="text-gray-500 text-sm">Sorular&#x131;n&#x131;z, &#xF6;nerileriniz veya geri bildirimleriniz i&#xE7;in bize ula&#x15F;&#x131;n.</p>
  </div>

  <!-- Info cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl p-5 flex items-start gap-4" style="border: 3px solid #e2e8f0;">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#FFF3E8;">
        <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <div>
        <h3 class="text-gray-800 mb-0.5">E-posta</h3>
        <p class="text-sm text-gray-500">info@kuponluk.com</p>
      </div>
    </div>
    <div class="bg-white rounded-2xl p-5 flex items-start gap-4" style="border: 3px solid #e2e8f0;">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#FFF3E8;">
        <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <div>
        <h3 class="text-gray-800 mb-0.5">Konum</h3>
        <p class="text-sm text-gray-500">&#x130;stanbul, T&#xFC;rkiye</p>
      </div>
    </div>
    <div class="bg-white rounded-2xl p-5 flex items-start gap-4" style="border: 3px solid #e2e8f0;">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#FFF3E8;">
        <svg class="w-5 h-5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <div>
        <h3 class="text-gray-800 mb-0.5">Telegram</h3>
        <a href="/telegram" class="text-sm hover:opacity-80 transition font-semibold" style="color:#FF6B00;">Kanalım&#x131;za kat&#x131;l&#x131;n</a>
      </div>
    </div>
  </div>

  <!-- Form + Map -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Contact form -->
    <div class="bg-white rounded-2xl p-6" style="border: 3px solid #e2e8f0;">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#FFF3E8;">
          <svg class="w-4 h-4" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        </div>
        <h2 class="text-gray-800">Mesaj G&#xF6;nderin</h2>
      </div>
      <div id="contactFormWrap">
        <form id="contactForm" novalidate class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ad Soyad <span style="color:#FF6B00">*</span></label>
            <input type="text" id="cName" placeholder="Ad&#x131;n&#x131;z ve soyad&#x131;n&#x131;z" required class="w-full px-3.5 py-2.5 rounded-xl border-2 border-gray-200 text-sm focus:outline-none focus:border-orange-400 transition">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">E-posta <span style="color:#FF6B00">*</span></label>
            <input type="email" id="cEmail" placeholder="ornek@eposta.com" required class="w-full px-3.5 py-2.5 rounded-xl border-2 border-gray-200 text-sm focus:outline-none focus:border-orange-400 transition">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Konu <span style="color:#FF6B00">*</span></label>
            <select id="cSubject" required class="w-full px-3.5 py-2.5 rounded-xl border-2 border-gray-200 text-sm focus:outline-none focus:border-orange-400 transition bg-white">
              <option value="">&mdash; Konu se&#xE7;in &mdash;</option>
              <option value="Kupon Onerisi">Kupon &#xD6;nerisi</option>
              <option value="Hata Bildirimi">Hata Bildirimi</option>
              <option value="Magaza Ekleme Talebi">Ma&#x11F;aza Ekleme Talebi</option>
              <option value="Is Birligi">&#x130;&#x15F; Birli&#x11F;i</option>
              <option value="Oneri">&#xD6;neri</option>
              <option value="Diger">Di&#x11F;er</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Mesaj&#x131;n&#x131;z <span style="color:#FF6B00">*</span></label>
            <textarea id="cMessage" rows="5" placeholder="Mesaj&#x131;n&#x131;z&#x131; buraya yaz&#x131;n..." required class="w-full px-3.5 py-2.5 rounded-xl border-2 border-gray-200 text-sm focus:outline-none focus:border-orange-400 transition resize-none"></textarea>
          </div>
          <div id="formError" class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl px-4 py-3 hidden"></div>
          <button type="submit" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-white font-semibold text-sm transition hover:opacity-90" style="background:#FF6B00;">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            G&#xF6;nder
          </button>
        </form>
      </div>
      <div id="contactSuccess" class="hidden text-center py-8">
        <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4" style="background:#dcfce7;">
          <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h2 class="text-gray-800 mb-2">Mesaj&#x131;n&#x131;z Al&#x131;nd&#x131;!</h2>
        <p class="text-gray-500 text-sm">En k&#x131;sa s&#xFC;rede size geri d&#xF6;n&#xFC;&#x15F; yapaca&#x11F;&#x131;z. Te&#x15F;ekk&#xFC;r ederiz.</p>
      </div>
    </div>

    <!-- Map -->
    <div class="bg-white rounded-2xl overflow-hidden" style="border: 3px solid #e2e8f0;">
      <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2">
        <svg class="w-4 h-4 flex-shrink-0" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="text-gray-700 text-sm font-semibold">Konum &mdash; &#x130;stanbul</span>
      </div>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d192697.92115055027!2d28.84788!3d41.005495!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa7040068086b%3A0xe1ccfe98bc01b0d0!2zxLBzdGFuYnVs!5e0!3m2!1str!2str!4v1685000000000!5m2!1str!2str"
        width="100%"
        height="420"
        style="border:0;display:block;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>

  </div>
</div>

<script>
document.getElementById('contactForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var name = document.getElementById('cName').value.trim();
  var email = document.getElementById('cEmail').value.trim();
  var subject = document.getElementById('cSubject').value;
  var message = document.getElementById('cMessage').value.trim();
  var errEl = document.getElementById('formError');
  errEl.classList.add('hidden');
  if (!name || !email || !subject || !message) {
    errEl.textContent = 'L\xFCtfen t\xFCm alanları doldurun.';
    errEl.classList.remove('hidden');
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errEl.textContent = 'Ge\xE7erli bir e-posta adresi girin.';
    errEl.classList.remove('hidden');
    return;
  }
  document.getElementById('contactFormWrap').classList.add('hidden');
  document.getElementById('contactSuccess').classList.remove('hidden');
});
</script>

<%- include('partials/footer') %>
</body>
</html>
