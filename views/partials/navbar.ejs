        <svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#FF6B00;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
      </div>
      <div class="flex-1 overflow-hidden relative">
        <div class="ticker-inner text-xs font-medium" style="color:#6b5c4c;">
          Trendyol'da yeni sezon indirimleri ba&#x15F;lad&#x131;! &nbsp;&bull;&nbsp; Hepsiburada elektronik f&#x131;rsatlar&#x131;nda %15 indirim! &nbsp;&bull;&nbsp; Amazon kitap al&#x131;&#x15F;veri&#x15F;inde &#xFC;cretsiz kargo! &nbsp;&bull;&nbsp; Nike yaz koleksiyonunda %20 indirim! &nbsp;&bull;&nbsp; Yemeksepeti ilk sipari&#x15F;e %40 indirim! &nbsp;&bull;&nbsp; MediaMarkt bilgisayarlarda %12 kampanya! &nbsp;&bull;&nbsp;
        </div>
      </div>
      <a href="/magazalar" class="flex-shrink-0 mx-3 text-xs font-semibold text-white px-3 py-0.5 rounded-full hover:opacity-90 transition whitespace-nowrap" style="background:#FF6B00;">T&#xFC;m&#xFC; &rarr;</a>
