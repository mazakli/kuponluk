<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-40 z-[9998] hidden" onclick="toggleRightSidebar()"></div>

<script>
function toggleRightSidebar() {
  var s = document.getElementById('rightSidebar'), o = document.getElementById('sidebarOverlay');
  var open = !s.classList.contains('translate-x-full');
  if (open) { s.classList.add('translate-x-full'); o.classList.add('hidden'); document.body.style.overflow = ''; }
  else { s.classList.remove('translate-x-full'); o.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
}
var mobileSearchBtn = document.getElementById('mobileSearchBtn');
if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', function() {
  var s = document.getElementById('mobileSearchBar');
  if (s) { s.classList.toggle('hidden'); var inp = s.querySelector('input'); if (inp) inp.focus(); }
});
(function() {
  var inp = document.getElementById('navSearchInput');
  if (!inp || inp.value) return;
  var suggestions = ['Trendyol indirim kodu ara…','Amazon kupon kodu…','Hepsiburada fırsatı ara…','Nike %20 indirim…','Yemeksepeti kupon…','Getir promosyon kodu…'];
  var si = 0, ci = 0, deleting = false, timer;
  function tick() {
    var s = suggestions[si];
    if (!deleting && ci <= s.length) { inp.placeholder = s.substring(0, ci++); timer = setTimeout(tick, 70); }
    else if (!deleting && ci > s.length) { deleting = true; timer = setTimeout(tick, 1800); }
    else if (deleting && ci > 0) { inp.placeholder = s.substring(0, ci--); timer = setTimeout(tick, 35); }
    else { deleting = false; si = (si + 1) % suggestions.length; timer = setTimeout(tick, 300); }
  }
  tick();
  inp.addEventListener('focus', function() { clearTimeout(timer); inp.placeholder = 'Kupon, mağaza veya marka ara…'; });
  inp.addEventListener('blur', function() { if (!inp.value) { ci = 0; deleting = false; tick(); } });
})();
</script>
