<style>
@keyframes tickerScroll {
  0%   { transform: translateX(100vw); }
  100% { transform: translateX(-100%); }
}
.ticker-inner { display:inline-block; white-space:nowrap; animation: tickerScroll 30s linear infinite; }
</style>

<!-- Top Bar -->
<div class="text-white text-xs py-1.5 px-4" style="background:#1a1a2e">
  <div class="max-w-7xl mx-auto flex justify-end items-center">
    <div class="flex items-center gap-3">
      <% if (currentUser) { %>
        <a href="/profil" class="hover:text-orange-400 transition"><strong class="text-orange-400"><%= currentUser.username %></strong></a>
        <a href="/mesajlar" class="relative inline-flex items-center hover:text-orange-400 transition" title="Mesajlar">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %><span class="absolute -top-2 -right-2 w-4 h-4 rounded-full bg-red-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"><%= unreadMessages > 9 ? '9+' : unreadMessages %></span><% } %>
        </a>
        <a href="/cikis" class="hover:text-orange-400 transition">Çıkış</a>
      <% } else { %>
        <a href="/giris" class="hover:text-orange-400 transition">Giriş Yap</a>
        <span class="text-gray-500">|</span>
        <a href="/kayit" class="hover:text-orange-400 transition font-semibold">Üye Ol</a>
      <% } %>
    </div>
  </div>
</div>

