<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Kuponluk.com - Türkiye\'nin en büyük kupon ve indirim platformu. Yüzlerce marka için güncel kupon kodları ve fırsatlar.' %>">
  <meta name="keywords" content="kupon kodu, indirim kodu, promosyon kodu, trendyol kupon, hepsiburada indirim, amazon kupon, ücretsiz kargo, banka kampanyaları">
  <meta name="robots" content="index, follow">
  <meta name="author" content="Kuponluk.com">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Kuponluk.com - Türkiye\'nin kupon merkezi' %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://kuponluk.com/img/og-image.png">
  <meta property="og:url" content="https://kuponluk.com<%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
  <meta property="og:site_name" content="Kuponluk.com">
  <meta property="og:locale" content="tr_TR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Kuponluk.com - Türkiye\'nin en büyük kupon ve indirim platformu.' %>">
  <meta name="twitter:image" content="https://kuponluk.com/img/og-image.png">
  <link rel="canonical" href="https://kuponluk.com<%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Kuponluk.com",
    "url": "https://kuponluk.com",
    "description": "Türkiye'nin en büyük kupon ve indirim platformu",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://kuponluk.com/arama?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { DEFAULT: '#FF6B00', dark: '#e55f00', light: '#ff8533' },
            dark: '#1a1a2e',
          },
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body, * { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
    h1 { font-size: 1.75rem; font-weight: 800; line-height: 1.2; }
    h2 { font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
    h3 { font-size: 1rem; font-weight: 600; line-height: 1.4; }
  </style>
  <link rel="stylesheet" href="/css/kuponluk.css">
</head>
<body style="background:#f0f2f5;" class="text-gray-800">
