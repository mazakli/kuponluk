<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kuponluk.com Widget</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:<%- tema==='dark'?'#0d1b3e':'#f1f5f9' %>;padding:10px;min-height:100vh}
.card{background:<%- tema==='dark'?'#1a2c56':'#ffffff' %>;border-radius:10px;padding:10px 12px;margin-bottom:8px;display:flex;align-items:center;gap:10px;border:1px solid <%- tema==='dark'?'#2a3f6f':'#e2e8f0' %>;}
.logo{width:38px;height:38px;border-radius:8px;background:#f97316;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;color:#fff;flex-shrink:0;overflow:hidden;position:relative;}
.logo img{width:100%;height:100%;object-fit:contain;background:#fff;padding:3px;position:absolute;top:0;left:0;}
.info{flex:1;min-width:0;}
.store-nm{font-size:12px;font-weight:700;color:<%- tema==='dark'?'#e2e8f0':'#1e293b' %>;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.disc{font-size:11px;color:#f97316;font-weight:600;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.btn{background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;border:none;border-radius:7px;padding:6px 11px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-block;flex-shrink:0;}
.footer-bar{text-align:center;margin-top:10px;padding-top:8px;border-top:1px solid <%- tema==='dark'?'#2a3f6f':'#e2e8f0' %>;}
.footer-bar a{font-size:11px;color:#f97316;text-decoration:none;font-weight:600;}
.empty{text-align:center;padding:24px 12px;color:<%- tema==='dark'?'#94a3b8':'#64748b' %>;font-size:13px;}
</style>
</head>
<body>
<% if (!coupons || coupons.length === 0) { %>
<div class="empty">&#x15E;u an aktif kupon bulunamad&#x131;.</div>
<% } else { %>
<% coupons.forEach(function(c) { %>
<div class="card">
  <div class="logo">
    <span><%= (c.store_name || 'K').charAt(0).toUpperCase() %></span>
    <img src="https://kuponluk.com/uploads/brands/<%= c.store_slug %>.png" alt="<%= c.store_name %>" onerror="this.style.display='none'">
  </div>
  <div class="info">
    <div class="store-nm"><%= c.store_name %></div>
    <div class="disc"><%= c.title %></div>
  </div>
  <a href="https://kuponluk.com/magaza/<%= c.store_slug %>?utm_source=widget&utm_medium=embed&utm_campaign=sitene-ekle" target="_blank" class="btn">
    <%= c.code ? 'Kodu Al' : 'F&#x131;rsata Git' %>
  </a>
</div>
<% }) %>
<% } %>
<div class="footer-bar">
  <a href="https://kuponluk.com?utm_source=widget&utm_medium=embed" target="_blank">&#x1F3F7;&#xFE0F; Kuponluk.com&rsquo;da t&#xFC;m f&#x131;rsatlar&#x131; g&#xF6;r &rarr;</a>
</div>
</body>
</html>
