<%- include('partials/head') %>

<div class="min-h-screen flex">
  <!-- Left brand panel -->
  <div class="hidden lg:flex lg:w-5/12 flex-col justify-between p-12" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);">
    <a href="/" class="flex items-center gap-3">
      <div class="w-10 h-10 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full">
          <rect width="100" height="100" rx="20" fill="#FF6B00"/>
          <rect x="30" y="15" width="42" height="70" rx="5" fill="white"/>
          <path d="M72 30 L88 50 L72 70 Z" fill="white"/>
          <circle cx="82" cy="50" r="6" fill="#FF6B00"/>
          <path d="M8 30 L44 50" stroke="#1a1a2e" stroke-width="7" stroke-linecap="round"/>
          <circle cx="7" cy="26" r="9" fill="none" stroke="#1a1a2e" stroke-width="5"/>
          <path d="M8 70 L44 50" stroke="#1a1a2e" stroke-width="7" stroke-linecap="round"/>
          <circle cx="7" cy="74" r="9" fill="none" stroke="#1a1a2e" stroke-width="5"/>
          <circle cx="44" cy="50" r="5" fill="#FF6B00" stroke="white" stroke-width="1.5"/>
          <line x1="49" y1="50" x2="80" y2="50" stroke="#1a1a2e" stroke-width="2.5" stroke-dasharray="5,4" opacity="0.6"/>
        </svg>
      </div>
      <span class="font-bold text-2xl text-white">Kuponluk<span style="color:#FF6B00">.com</span></span>
    </a>

    <div>
      <h2 class="text-3xl font-extrabold text-white mb-4 leading-tight">Akıllı Alışverişin Adresi</h2>
      <p class="text-gray-300 mb-8 leading-relaxed">Binlerce kupon, yüzlerce marka. Hepsini tek yerden takip edin ve hiçbir fırsatı kaçırmayın.</p>
      <ul class="space-y-4">
        <li class="flex items-center gap-3 text-white">
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:#FF6B00">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="text-sm">Kuponları kaydedin, istediğinizde kullanın</span>
        </li>
        <li class="flex items-center gap-3 text-white">
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:#FF6B00">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="text-sm">Yeni kupon geldiğinde anında bildirim alın</span>
        </li>
        <li class="flex items-center gap-3 text-white">
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:#FF6B00">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="text-sm">Kendi bulduğunuz kuponları paylaşın</span>
        </li>
        <li class="flex items-center gap-3 text-white">
          <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:#FF6B00">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="text-sm">Tamamen ücretsiz, reklam yok</span>
        </li>
      </ul>
    </div>

    <div class="grid grid-cols-3 gap-4 pt-8 border-t border-white border-opacity-10">
      <div class="text-center">
        <div class="text-2xl font-extrabold text-white">500+</div>
        <div class="text-gray-400 text-xs mt-1">Mağaza</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-extrabold text-white">10K+</div>
        <div class="text-gray-400 text-xs mt-1">Kupon</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-extrabold text-white">50K+</div>
        <div class="text-gray-400 text-xs mt-1">Üye</div>
      </div>
    </div>
  </div>

  <!-- Right form panel -->
  <div class="flex-1 flex items-center justify-center py-12 px-4 bg-gray-50">
    <div class="max-w-md w-full">

      <!-- Logo (mobile only) -->
      <div class="text-center mb-8 lg:hidden">
        <a href="/" class="inline-block">
          <span class="text-3xl font-extrabold" style="color:#FF6B00;">kuponluk</span><span class="text-3xl font-extrabold text-gray-800">.com</span>
        </a>
      </div>

      <h1 class="text-2xl font-bold text-gray-800 mb-1">Ücretsiz Hesap Oluşturun</h1>
      <p class="text-gray-500 mb-6">Kuponları kaydedin, fırsatları kaçırmayın.</p>

      <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span><%= error %></span>
      </div>
      <% } %>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
        <form action="/kayit" method="POST" class="space-y-5">
          <div>
            <label for="username" class="block text-sm font-semibold text-gray-700 mb-1.5">Kullanıcı Adı</label>
            <input type="text" id="username" name="username" required autocomplete="username"
              placeholder="kullanici_adi"
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition" />
            <p class="text-xs text-gray-400 mt-1">Sadece harf, rakam ve alt çizgi kullanabilirsiniz.</p>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">E-posta Adresi</label>
            <input type="email" id="email" name="email" required autocomplete="email"
              placeholder="ornek@email.com"
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition" />
          </div>
          <div>
            <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5">Şifre</label>
            <input type="password" id="password" name="password" required autocomplete="new-password"
              placeholder="En az 6 karakter"
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition" />
          </div>
          <div>
            <label for="password2" class="block text-sm font-semibold text-gray-700 mb-1.5">Şifre Tekrar</label>
            <input type="password" id="password2" name="password2" required autocomplete="new-password"
              placeholder="Şifrenizi tekrar girin"
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition" />
          </div>
          <div>
            <label class="flex items-start gap-2 text-sm text-gray-600 cursor-pointer">
              <input type="checkbox" name="terms" required class="mt-0.5 rounded border-gray-300 accent-orange-500 flex-shrink-0" />
              <span>
                <a href="/kullanim-kosullari" class="font-semibold hover:underline" style="color:#FF6B00;" target="_blank">Kullanım Koşulları</a>'nı ve
                <a href="/gizlilik-politikasi" class="font-semibold hover:underline" style="color:#FF6B00;" target="_blank">Gizlilik Politikası</a>'nı okudum ve kabul ediyorum.
              </span>
            </label>
          </div>
          <button type="submit" class="w-full text-white font-bold py-3 rounded-xl transition hover:opacity-90 text-lg" style="background:#FF6B00;">
            Üye Ol
          </button>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-100 text-center">
          <p class="text-gray-600">Zaten hesabınız var mı?
            <a href="/giris" class="font-bold hover:underline" style="color:#FF6B00;">Giriş Yapın</a>
          </p>
        </div>
      </div>

      <div class="text-center mt-6 text-sm text-gray-500 flex items-center justify-center gap-1.5">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Güvenli kayıt. Verileriniz asla üçüncü taraflarla paylaşılmaz.
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
