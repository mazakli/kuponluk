<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-2xl mx-auto px-4 py-8">

  <!-- Breadcrumb -->
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/ilanlar" class="hover:text-orange-600 transition">İlanlar</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium">İlan Oluştur</span>
  </nav>

  <% if (!currentUser) { %>
  <div class="bg-orange-50 border-2 border-orange-200 rounded-2xl p-10 text-center">
    <svg class="w-12 h-12 mx-auto mb-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
    <h2 class="text-xl font-bold text-gray-800 mb-2">Üye Girişi Gerekli</h2>
    <p class="text-gray-600 mb-5">İlan oluşturmak için önce giriş yapmanız gerekmektedir.</p>
    <a href="/giris?redirect=/ilanlar/olustur" class="inline-block px-6 py-2.5 rounded-xl text-white font-bold hover:opacity-90 transition" style="background:#FF6B00;">Giriş Yap</a>
  </div>
  <% } else { %>

  <% if (success) { %>
  <div class="bg-green-50 border-2 border-green-200 rounded-2xl p-8 text-center mb-6">
    <svg class="w-12 h-12 mx-auto mb-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <h3 class="text-lg font-bold text-gray-800 mb-1">İlanınız Alındı!</h3>
    <p class="text-sm text-gray-600 mb-4">Admin onayından sonra yayına girecektir. Teşekkür ederiz!</p>
    <div class="flex justify-center gap-3">
      <a href="/ilanlar" class="px-5 py-2 rounded-xl border-2 font-semibold transition hover:bg-orange-50" style="color:#FF6B00;border-color:#FF6B00;">İlanlara Dön</a>
      <a href="/ilanlar/olustur" class="px-5 py-2 rounded-xl text-white font-bold hover:opacity-90 transition" style="background:#FF6B00;">Yeni İlan</a>
    </div>
  </div>
  <% } %>

  <% if (error) { %>
  <div class="bg-red-50 border-2 border-red-200 text-red-700 rounded-xl px-5 py-4 mb-5 flex items-start gap-3">
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <span><%= error %></span>
  </div>
  <% } %>

  <% if (!success) { %>
  <div class="mb-5">
    <h1 class="text-2xl font-extrabold text-gray-900">İlan Oluştur</h1>
    <p class="text-gray-500 mt-1">Kupon kodunuzu veya indirimi diğer üyelerle paylaşın.</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border-2 border-gray-100 p-6">
    <form action="/ilanlar/olustur" method="POST" class="space-y-5">

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">İlan Başlığı <span class="text-red-500">*</span></label>
        <input type="text" name="title" required placeholder="örn. Trendyol %30 indirim kodu paylaşıyorum"
          class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition"/>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Mağaza Adı <span class="text-red-500">*</span></label>
          <input type="text" name="store_name" required placeholder="örn. Trendyol"
            class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition"/>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kategori</label>
          <input type="text" name="category" placeholder="örn. Elektronik, Moda"
            class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition"/>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kupon Kodu</label>
        <input type="text" name="coupon_code" placeholder="örn. KUPON30"
          class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition font-mono tracking-wider"/>
        <p class="text-xs text-gray-400 mt-1">Kod yoksa boş bırakabilirsiniz.</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Fiyat</label>
        <label class="flex items-center gap-2 cursor-pointer mb-2">
          <input type="checkbox" name="is_free" value="1" class="accent-orange-500 w-4 h-4">
          <span class="text-sm text-gray-700 font-medium">Ücretsiz devrediyorum</span>
        </label>
        <input type="number" name="price" min="0" step="0.01" placeholder="Üretli ise fiyat girin (TL)"
          class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition"/>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Açıklama</label>
        <textarea name="description" rows="3" placeholder="Kupon hakkında detayları yazın..."
          class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition resize-none"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Son Kullanma Tarihi</label>
        <input type="date" name="expires_at"
          class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:outline-none focus:border-orange-400 text-gray-800 transition"/>
      </div>

      <div class="bg-orange-50 border-2 border-orange-100 rounded-xl p-4">
        <p class="text-xs text-gray-600 flex items-start gap-2">
          <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color:#FF6B00" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>İlanınız admin onayından geçtikten sonra yayına girecektir. Sahte veya yanıltıcı ilanlar silinecektir.</span>
        </p>
      </div>

      <button type="submit" class="w-full text-white font-bold py-3.5 rounded-xl transition hover:opacity-90 text-base" style="background:#FF6B00;">
        İlan Gönder
      </button>
    </form>
  </div>
  <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
</body>
</html>
