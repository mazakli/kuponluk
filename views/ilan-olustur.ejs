<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <nav class="text-sm text-gray-500 flex items-center gap-1.5 mb-6">
    <a href="/" class="hover:text-orange-600 transition">Ana Sayfa</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/ilanlar" class="hover:text-orange-600 transition">&#x130;lanlar</a>
    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-800 font-medium">&#x130;lan Olu&#x15F;tur</span>
  </nav>

  <div class="mb-6">
    <h1 class="text-2xl font-extrabold text-gray-900">Yeni &#x130;lan Olu&#x15F;tur</h1>
    <p class="text-gray-500 mt-1 text-sm">Kupon kodunuzu veya kampanyan&#x131;z&#x131; toplulukla payla&#x15F;&#x131;n.</p>
  </div>

  <% if (success) { %>
  <div class="bg-green-50 border-2 border-green-200 rounded-2xl p-6 text-center mb-6">
    <svg class="w-12 h-12 mx-auto mb-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <h2 class="text-lg font-bold text-green-800 mb-1">&#x130;lan&#x131;n&#x131;z G&#xF6;nderildi!</h2>
    <p class="text-green-600 text-sm">&#x130;lan&#x131;n&#x131;z inceleme s&#xFC;recinde. Onaylandiktan sonra yay&#x131;nlanacakt&#x131;r.</p>
    <div class="flex gap-3 justify-center mt-4">
      <a href="/ilanlar" class="px-5 py-2 rounded-xl border-2 border-gray-200 text-gray-700 font-semibold text-sm hover:bg-gray-50 transition">&#x130;lanlara D&#xF6;n</a>
      <a href="/ilanlar/olustur" class="px-5 py-2 rounded-xl text-white font-semibold text-sm hover:opacity-90 transition" style="background:#FF6B00;">Yeni &#x130;lan</a>
    </div>
  </div>
  <% } else { %>

  <% if (error) { %>
  <div class="bg-red-50 border-2 border-red-200 rounded-xl p-4 mb-5 text-sm text-red-700">
    <strong>Hata:</strong> <%= error %>
  </div>
  <% } %>

  <form action="/ilanlar/olustur" method="POST" class="space-y-5">
    <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6 space-y-5">
      <h2 class="font-bold text-gray-800 flex items-center gap-2">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-xs font-bold" style="background:#FF6B00;">1</span>
        Temel Bilgiler
      </h2>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">&#x130;lan Ba&#x15F;l&#x131;&#x11F;&#x131; <span class="text-red-500">*</span></label>
        <input type="text" name="title" required maxlength="120" placeholder="&#xD6;rn: Trendyol %20 indirim kodu payla&#x15F;&#x131;yorum"
          class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-300 transition">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ma&#x11F;aza Ad&#x131; <span class="text-red-500">*</span></label>
          <input type="text" name="store_name" required maxlength="80" placeholder="&#xD6;rn: Trendyol"
            class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-300 transition">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kategori</label>
          <select name="category" class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-300 transition bg-white">
            <option value="">Se&#x00E7;iniz...</option>
            <option>Moda &amp; Giyim</option>
            <option>Elektronik</option>
            <option>Yemek &amp; Restoran</option>
            <option>Seyahat</option>
            <option>Kozmetik &amp; G&#xFC;zellik</option>
            <option>Spor &amp; Outdoor</option>
            <option>Ev &amp; Ya&#x15F;am</option>
            <option>Kitap &amp; E&#x11F;itim</option>
            <option>Market &amp; S&#xFC;permarket</option>
            <option>Teknoloji &amp; Yaz&#x131;l&#x131;m</option>
            <option>Di&#x11F;er</option>
          </select>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border-2 border-gray-100 shadow-sm p-6 space-y-5">
      <h2 class="font-bold text-gray-800 flex items-center gap-2">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-xs font-bold" style="background:#FF6B00;">2</span>
        Kupon Detaylar&#x131;
      </h2>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kupon / &#x130;ndirim Kodu <span class="text-gray-400 font-normal">(opsiyonel)</span></label>
        <input type="text" name="coupon_code" maxlength="50" placeholder="&#xD6;rn: TRENDYOL20"
          class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm font-mono focus:outline-none focus:border-orange-300 transition uppercase">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">A&#x00E7;&#x131;klama</label>
        <textarea name="description" rows="3" maxlength="500" placeholder="Kupon hakk&#x131;nda bilgi, kullan&#x131;m ko&#x15F;ullar&#x131;, &#x00F6;nemli notlar..."
          class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-300 transition resize-none"></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Son Ge&#x00E7;erlilik Tarihi</label>
          <input type="date" name="expires_at"
            class="w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-orange-300 transition">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-3">&#x130;lan T&#xFC;r&#xFC;</label>
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="is_free" value="1" id="isFreeCheck" class="accent-orange-500" onchange="togglePrice(this)">
              <span class="text-sm text-gray-700">&#xDC;cretsiz / Bedava</span>
            </label>
          </div>
          <div id="priceWrapper" class="mt-2">
            <input type="number" name="price" min="0" step="0.01" placeholder="Fiyat (TL)"
              class="w-full border-2 border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-orange-300 transition">
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-3 justify-end">
      <a href="/ilanlar" class="px-6 py-3 rounded-xl border-2 border-gray-200 text-gray-700 font-semibold text-sm hover:bg-gray-50 transition">&#x130;ptal</a>
      <button type="submit" class="px-8 py-3 rounded-xl text-white font-bold text-sm hover:opacity-90 transition" style="background:#FF6B00;">&#x130;lan&#x131; G&#xF6;nder</button>
    </div>
  </form>
  <% } %>
</div>

<script>
function togglePrice(cb) {
  var w = document.getElementById('priceWrapper');
  if (w) w.style.opacity = cb.checked ? '0.4' : '1';
  var inp = w ? w.querySelector('input') : null;
  if (inp) inp.disabled = cb.checked;
}
</script>

<%- include('partials/footer') %>
</body>
</html>
